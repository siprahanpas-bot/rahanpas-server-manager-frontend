# Host port
APP_PORT=13000

# Nuxt server runtime
NITRO_HOST=0.0.0.0
NITRO_PORT=3000

# Laravel backend API reachable from Docker network
NUXT_API_INTERNAL_BASE=http://rahanpas-backend-nginx/api

# Existing shared Docker network
DOCKER_NETWORK=baota_net

# Container name
CONTAINER_NAME=rahanpas-server-manager-frontend
