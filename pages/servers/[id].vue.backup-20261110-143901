<script setup lang="ts">
const route = useRoute()
const serverId = computed(() => String(route.params.id))

interface ManagedServer {
  id: number
  name: string
  hostname: string | null
  ip_address: string | null
  os_type: 'linux' | 'windows'
  connection_protocol: string
  port: number
  username: string
  auth_method: 'password' | 'private_key'
  verify_host_key: boolean
  host_key_fingerprint: string | null
  status: string
  last_checked_at: string | null
  last_error: string | null
  notes: string | null
  created_at: string
  updated_at: string
}

const server = ref<ManagedServer | null>(null)
const loading = ref(true)
const saving = ref(false)
const deleting = ref(false)
const editing = ref(false)
const errorMessage = ref('')
const fieldErrors = ref<Record<string, string[]>>({})

const form = reactive({
  name: '',
  hostname: '',
  ip_address: '',
  os_type: 'linux',
  connection_protocol: 'ssh',
  port: 22,
  username: '',
  auth_method: 'password',
  password: '',
  private_key: '',
  private_key_passphrase: '',
  verify_host_key: true,
  host_key_fingerprint: '',
  notes: ''
})

const credentialChanged = computed(() => {
  if (!server.value) return false
  return form.auth_method !== server.value.auth_method
})

function applyServer(data: ManagedServer) {
  server.value = data

  form.name = data.name || ''
  form.hostname = data.hostname || ''
  form.ip_address = data.ip_address || ''
  form.os_type = data.os_type
  form.connection_protocol = data.connection_protocol
  form.port = data.port
  form.username = data.username
  form.auth_method = data.auth_method
  form.verify_host_key = data.verify_host_key
  form.host_key_fingerprint = data.host_key_fingerprint || ''
  form.notes = data.notes || ''

  // Credential lama tidak pernah dimuat ke browser.
  form.password = ''
  form.private_key = ''
  form.private_key_passphrase = ''
}

async function loadServer() {
  loading.value = true
  errorMessage.value = ''

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId.value}`
    )

    if (!result.server) {
      throw new Error('Data server tidak ditemukan.')
    }

    applyServer(result.server)
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    errorMessage.value =
      error.data?.statusMessage ||
      error.data?.message ||
      error.message ||
      'Gagal mengambil detail server.'
  } finally {
    loading.value = false
  }
}

watch(() => form.os_type, (os) => {
  if (os === 'linux') {
    form.connection_protocol = 'ssh'
    form.port = 22
  } else {
    form.connection_protocol = 'winrm'
    form.port = 5985
  }
})

watch(() => form.connection_protocol, (protocol) => {
  form.port = protocol === 'winrm' ? 5985 : 22

  if (protocol === 'winrm' && form.auth_method === 'private_key') {
    form.auth_method = 'password'
  }
})

watch(() => form.auth_method, (method, previous) => {
  if (method !== previous) {
    form.password = ''
    form.private_key = ''
    form.private_key_passphrase = ''
  }
})

function getError(field: string) {
  return fieldErrors.value[field]?.[0] || ''
}

async function saveServer() {
  if (!server.value) return

  errorMessage.value = ''
  fieldErrors.value = {}

  if (form.auth_method === 'password' && credentialChanged.value && !form.password) {
    errorMessage.value = 'Password baru wajib diisi saat mengganti metode autentikasi.'
    return
  }

  if (form.auth_method === 'private_key' && credentialChanged.value && !form.private_key.trim()) {
    errorMessage.value = 'Private key baru wajib diisi saat mengganti metode autentikasi.'
    return
  }

  saving.value = true

  const payload: Record<string, any> = {
    name: form.name,
    hostname: form.hostname || null,
    ip_address: form.ip_address || null,
    os_type: form.os_type,
    connection_protocol: form.connection_protocol,
    port: form.port,
    username: form.username,
    auth_method: form.auth_method,
    verify_host_key: form.verify_host_key,
    host_key_fingerprint: form.host_key_fingerprint || null,
    notes: form.notes || null
  }

  // Kirim kredensial hanya jika pengguna memasukkan kredensial baru.
  if (form.auth_method === 'password' && form.password) {
    payload.password = form.password
  }

  if (form.auth_method === 'private_key' && form.private_key.trim()) {
    payload.private_key = form.private_key
    if (form.private_key_passphrase) {
      payload.private_key_passphrase = form.private_key_passphrase
    }
  }

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId.value}`,
      {
        method: 'PUT',
        body: payload
      }
    )

    if (result.server) {
      applyServer(result.server)
    }

    editing.value = false
    errorMessage.value = ''
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    errorMessage.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal memperbarui konfigurasi server.'

    fieldErrors.value =
      error.data?.data?.errors ||
      error.data?.errors ||
      {}
  } finally {
    saving.value = false
  }
}

function cancelEdit() {
  if (server.value) {
    applyServer(server.value)
  }

  editing.value = false
  errorMessage.value = ''
  fieldErrors.value = {}
}

async function deleteServer() {
  if (!server.value) return

  const confirmed = confirm(
    `Hapus server "${server.value.name}"? Tindakan ini tidak dapat dibatalkan.`
  )

  if (!confirmed) return

  deleting.value = true
  errorMessage.value = ''

  try {
    await $fetch(`/manager-api/servers/${serverId.value}`, {
      method: 'DELETE'
    })

    await navigateTo('/servers')
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    errorMessage.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal menghapus server.'
  } finally {
    deleting.value = false
  }
}

function formatDate(value: string | null) {
  if (!value) return 'Belum diperiksa'

  return new Date(value).toLocaleString('id-ID', {
    dateStyle: 'medium',
    timeStyle: 'short'
  })
}

function statusClass(status: string) {
  return {
    online: 'status-online',
    offline: 'status-offline',
    error: 'status-error',
    unknown: 'status-unknown'
  }[status] || 'status-unknown'
}

onMounted(loadServer)
</script>

<template>
  <main class="page">
    <header class="topbar">
      <div>
        <div class="breadcrumb">Workspace / Infrastructure / Servers / Detail</div>
        <h1>{{ server?.name || 'Server Detail' }}</h1>
        <p>Informasi dan konfigurasi server yang terdaftar.</p>
      </div>

      <NuxtLink to="/servers" class="back-button">
        ← Back to Servers
      </NuxtLink>
    </header>

    <div class="content">
      <div v-if="loading" class="panel empty">
        Memuat detail server...
      </div>

      <div v-else-if="!server" class="panel empty">
        <h2>Server tidak ditemukan</h2>
        <p>{{ errorMessage }}</p>
        <NuxtLink to="/servers" class="secondary-button">
          Kembali ke daftar server
        </NuxtLink>
      </div>

      <template v-else>
        <section class="overview">
          <article class="overview-card">
            <span>SERVER STATUS</span>
            <strong class="status" :class="statusClass(server.status)">
              {{ server.status }}
            </strong>
            <small>Monitoring belum dijalankan</small>
          </article>

          <article class="overview-card">
            <span>OPERATING SYSTEM</span>
            <strong>{{ server.os_type === 'linux' ? '🐧 Linux' : '▣ Windows' }}</strong>
            <small>{{ server.connection_protocol.toUpperCase() }}</small>
          </article>

          <article class="overview-card">
            <span>IP ADDRESS</span>
            <strong>{{ server.ip_address || '-' }}</strong>
            <small>{{ server.hostname || 'Hostname tidak tersedia' }}</small>
          </article>

          <article class="overview-card">
            <span>LAST CHECK</span>
            <strong class="last-check">{{ formatDate(server.last_checked_at) }}</strong>
            <small>Belum ada pemeriksaan koneksi</small>
          </article>
        </section>

        <section class="panel">
          <div class="panel-heading">
            <div>
              <h2>{{ editing ? 'Edit Server Configuration' : 'Server Configuration' }}</h2>
              <p>
                {{ editing
                  ? 'Perbarui identitas dan pengaturan koneksi server.'
                  : 'Informasi konfigurasi server yang tersimpan.' }}
              </p>
            </div>

            <button
              v-if="!editing"
              class="primary-button"
              @click="editing = true"
            >
              ✎ Edit Server
            </button>
          </div>

          <form v-if="editing" class="form-body" @submit.prevent="saveServer">
            <div class="section-heading">01 — Server Information</div>

            <div class="fields">
              <label class="field full">
                <span>Server Name *</span>
                <input v-model.trim="form.name" required maxlength="100" />
                <small v-if="getError('name')" class="field-error">{{ getError('name') }}</small>
              </label>

              <label class="field">
                <span>IP Address</span>
                <input v-model.trim="form.ip_address" placeholder="192.168.1.10" />
                <small v-if="getError('ip_address')" class="field-error">{{ getError('ip_address') }}</small>
              </label>

              <label class="field">
                <span>Hostname / FQDN</span>
                <input v-model.trim="form.hostname" placeholder="server.example.com" />
              </label>

              <label class="field">
                <span>Operating System *</span>
                <select v-model="form.os_type">
                  <option value="linux">Linux</option>
                  <option value="windows">Windows Server</option>
                </select>
              </label>

              <label class="field">
                <span>Connection Protocol *</span>
                <select v-model="form.connection_protocol">
                  <option v-if="form.os_type === 'linux'" value="ssh">SSH</option>
                  <template v-else>
                    <option value="winrm">WinRM</option>
                    <option value="windows_openssh">Windows OpenSSH</option>
                  </template>
                </select>
                <small v-if="getError('connection_protocol')" class="field-error">
                  {{ getError('connection_protocol') }}
                </small>
              </label>

              <label class="field">
                <span>Port *</span>
                <input v-model.number="form.port" type="number" min="1" max="65535" required />
                <small v-if="getError('port')" class="field-error">{{ getError('port') }}</small>
              </label>

              <label class="field">
                <span>Username *</span>
                <input v-model.trim="form.username" required maxlength="100" />
              </label>
            </div>

            <div class="section-heading">02 — Authentication</div>

            <div class="fields">
              <label class="field full">
                <span>Authentication Method *</span>
                <select v-model="form.auth_method">
                  <option value="password">Username & Password</option>
                  <option value="private_key" :disabled="form.connection_protocol === 'winrm'">
                    SSH Private Key
                  </option>
                </select>
              </label>

              <label v-if="form.auth_method === 'password'" class="field full">
                <span>
                  {{ credentialChanged ? 'New Password *' : 'New Password (Optional)' }}
                </span>
                <input
                  v-model="form.password"
                  type="password"
                  :required="credentialChanged"
                  autocomplete="new-password"
                  placeholder="Kosongkan jika tidak ingin mengganti password"
                />
                <small>Password lama tidak ditampilkan. Isi hanya jika ingin menggantinya.</small>
                <small v-if="getError('password')" class="field-error">{{ getError('password') }}</small>
              </label>

              <template v-else>
                <label class="field full">
                  <span>
                    {{ credentialChanged ? 'New Private Key *' : 'New Private Key (Optional)' }}
                  </span>
                  <textarea
                    v-model="form.private_key"
                    :required="credentialChanged"
                    rows="7"
                    spellcheck="false"
                    placeholder="Kosongkan jika tidak ingin mengganti private key"
                  />
                  <small>Private key lama tidak ditampilkan.</small>
                  <small v-if="getError('private_key')" class="field-error">{{ getError('private_key') }}</small>
                </label>

                <label class="field full">
                  <span>New Private Key Passphrase (Optional)</span>
                  <input
                    v-model="form.private_key_passphrase"
                    type="password"
                    autocomplete="new-password"
                    placeholder="Isi jika ingin memperbarui passphrase"
                  />
                </label>
              </template>
            </div>

            <div class="section-heading">03 — Security & Notes</div>

            <label v-if="form.connection_protocol !== 'winrm'" class="checkbox-field">
              <input v-model="form.verify_host_key" type="checkbox" />
              <span>
                <strong>Require host key verification</strong>
                <small>Verifikasi identitas host SSH sebelum koneksi.</small>
              </span>
            </label>

            <label class="field full">
              <span>Host Key Fingerprint</span>
              <input v-model.trim="form.host_key_fingerprint" placeholder="SHA256:..." />
            </label>

            <label class="field full notes-field">
              <span>Notes</span>
              <textarea v-model="form.notes" rows="3" placeholder="Catatan tambahan..." />
            </label>

            <div v-if="errorMessage" class="alert" role="alert">
              {{ errorMessage }}
            </div>

            <div class="form-footer">
              <button type="button" class="secondary-button" :disabled="saving" @click="cancelEdit">
                Cancel
              </button>
              <button type="submit" class="primary-button" :disabled="saving">
                {{ saving ? 'Saving...' : 'Save Changes →' }}
              </button>
            </div>
          </form>

          <div v-else class="detail-body">
            <div class="detail-grid">
              <div class="detail-item">
                <span>Server Name</span>
                <strong>{{ server.name }}</strong>
              </div>
              <div class="detail-item">
                <span>IP Address</span>
                <strong>{{ server.ip_address || '-' }}</strong>
              </div>
              <div class="detail-item">
                <span>Hostname / FQDN</span>
                <strong>{{ server.hostname || '-' }}</strong>
              </div>
              <div class="detail-item">
                <span>Operating System</span>
                <strong>{{ server.os_type }}</strong>
              </div>
              <div class="detail-item">
                <span>Connection Protocol</span>
                <strong>{{ server.connection_protocol.toUpperCase() }}</strong>
              </div>
              <div class="detail-item">
                <span>Port</span>
                <strong>{{ server.port }}</strong>
              </div>
              <div class="detail-item">
                <span>Username</span>
                <strong>{{ server.username }}</strong>
              </div>
              <div class="detail-item">
                <span>Authentication</span>
                <strong>{{ server.auth_method === 'password' ? 'Username & Password' : 'Private Key' }}</strong>
              </div>
              <div class="detail-item">
                <span>Host Key Verification</span>
                <strong>{{ server.verify_host_key ? 'Enabled' : 'Disabled' }}</strong>
              </div>
              <div class="detail-item">
                <span>Host Key Fingerprint</span>
                <strong>{{ server.host_key_fingerprint || '-' }}</strong>
              </div>
              <div class="detail-item">
                <span>Created At</span>
                <strong>{{ formatDate(server.created_at) }}</strong>
              </div>
              <div class="detail-item">
                <span>Last Updated</span>
                <strong>{{ formatDate(server.updated_at) }}</strong>
              </div>
            </div>

            <div class="notes">
              <span>NOTES</span>
              <p>{{ server.notes || 'Tidak ada catatan.' }}</p>
            </div>

            <div v-if="server.last_error" class="alert">
              {{ server.last_error }}
            </div>
          </div>
        </section>

        <section v-if="!editing" class="danger-zone">
          <div>
            <h3>Danger Zone</h3>
            <p>Penghapusan server tidak dapat dibatalkan.</p>
          </div>
          <button class="danger-button" :disabled="deleting" @click="deleteServer">
            {{ deleting ? 'Deleting...' : 'Delete Server' }}
          </button>
        </section>

        <div v-if="errorMessage && !editing" class="alert">
          {{ errorMessage }}
        </div>
      </template>
    </div>
  </main>
</template>

