                class="fm-drive-card"
              >
                <div class="fm-drive-card-heading">
                  <div class="fm-drive-icon">
                    <span aria-hidden="true">▤</span>
                  </div>
                  <div class="fm-drive-title">
                    <strong>{{ device.name || device.kname || device.path }}</strong>
                    <span>{{ device.model || 'Physical disk' }} · {{ device.size || '-' }}</span>
                  </div>
                  <span
                    class="fm-drive-status"
                    :class="storageDeviceMountpoint(device) ? 'is-mounted' : 'is-unavailable'"
                  >
                    {{ storageDeviceStatus(device) }}
                  </span>
                </div>

                <div class="fm-drive-details">
                  <div>
                    <span>Device</span>
                    <strong>{{ device.path || '-' }}</strong>
                  </div>
                  <div>
                    <span>Transport</span>
                    <strong>{{ device.tran || 'Virtual / Unknown' }}</strong>
                  </div>
                  <div>
                    <span>Read only</span>
                    <strong>{{ device.ro ? 'Yes' : 'No' }}</strong>
                  </div>
