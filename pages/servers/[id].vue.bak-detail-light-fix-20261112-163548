                <div
                  v-if="Array.isArray(device.children) && device.children.length"
                  class="fm-drive-volumes"
                >
                  <h4>Volumes / Partitions</h4>

                  <div
                    v-for="(volume, volumeIndex) in device.children"
                    :key="volume.path || volume.kname || volumeIndex"
                    class="fm-volume-item"
                  >
                    <div class="fm-volume-icon" aria-hidden="true">▱</div>

                    <div class="fm-volume-info">
                      <strong>{{ volume.name || volume.path }}</strong>
                      <span>
                        {{ volume.size || '-' }}
                        · {{ volume.fstype || 'Filesystem unknown' }}
                        <template v-if="volume.label"> · {{ volume.label }}</template>
                        <template v-if="volume.uuid"> · UUID {{ volume.uuid }}</template>
                      </span>
                      <span v-if="volume.mountpoint" class="fm-volume-mount">
                        {{ volume.mountpoint }}
                      </span>
                      <span v-else class="fm-volume-unmounted">
                        Not mounted
                      </span>
                    </div>

                    <button
                      v-if="storageCanMount(volume)"
                      type="button"
                      class="fm-button fm-secondary"
                      :disabled="storageActionDevice !== ''"
                      @click="runStorageAction(volume, 'mount')"
                    >
                      {{ storageActionDevice === volume.path ? 'Mounting...' : 'Mount' }}
                    </button>

                    <button
                      v-if="storageCanUnmount(volume)"
                      type="button"
                      class="fm-button fm-secondary"
                      :disabled="storageActionDevice !== ''"
                      @click="runStorageAction(volume, 'unmount')"
                    >
                      {{ storageActionDevice === volume.path ? 'Unmounting...' : 'Unmount' }}
                    </button>

                    <button
                      v-if="volume.mountpoint"
                      type="button"
                      class="fm-button fm-secondary"
                      :disabled="!storageCanExplore(volume.mountpoint)"
                      :title="storageCanExplore(volume.mountpoint)
                        ? 'Explore volume'
                        : 'Mount point berada di luar direktori yang saat ini diizinkan'"
                      @click="openStorageMount(volume.mountpoint)"
                    >
                      Explore
                    </button>
                  </div>
                </div>

                <div v-else class="fm-drive-empty">
                  Tidak ada partisi yang terdeteksi pada perangkat ini.
                </div>

                <div
                  v-if="storageCanInitialize(device)"
                  class="fm-drive-format-action"
                >
                  <button
                    type="button"
                    class="fm-button fm-format-button"
                    title="Initialize dan format disk"
                    @click="openStorageFormatDialog(device)"
                  >
                    Initialize & Format
                  </button>
                  <span>
                    Gunakan untuk menyiapkan disk kosong dengan tabel partisi GPT.
                  </span>
                </div>

                <div
                  v-if="device.mountpoint"
                  class="fm-drive-footer"
                >
                  <span>Mount point: {{ device.mountpoint }}</span>
                  <button
                    type="button"
                    class="fm-button fm-secondary"
                    :disabled="!storageCanExplore(device.mountpoint)"
                    @click="openStorageMount(device.mountpoint)"
                  >
                    Explore
                  </button>
                </div>
              </article>
            </div>

            <div v-else class="fm-placeholder">
              Tidak ada perangkat storage yang ditemukan.
            </div>

            <div v-if="storageMounts.length" class="fm-mount-list">
              <h4>Filesystem Mounts</h4>
              <div
                v-for="(mount, index) in storageMounts"
                :key="`${mount.target || ''}-${index}`"
                class="fm-mount-item"
              >
                <strong>{{ mount.target || '-' }}</strong>
                <span>{{ mount.source || '-' }} · {{ mount.fstype || '-' }}</span>
              </div>
            </div>

            <p v-if="storageDetectedAt" class="fm-storage-footer">
              Data diperbarui: {{ formatDate(storageDetectedAt) }}
            </p>
          </div>

          <section class="fm-explorer">
            <div class="fm-storage-heading">
              <div>
                <h3>File Explorer</h3>
                <p>Jelajahi file dan folder pada HOME atau mount point yang dipilih.</p>
              </div>
              <button
                v-if="fileManagerData"
                type="button"
                class="fm-button fm-secondary"
                :disabled="fileManagerLoading || fileManagerActionLoading"
                @click="loadRemoteFiles(fileManagerData.current_path)"
              >
                {{ fileManagerLoading ? 'Memuat...' : '↻ Refresh' }}
              </button>
            </div>

            <div v-if="fileManagerError" class="fm-error" role="alert">
              {{ fileManagerError }}
            </div>

            <div
              v-if="!fileManagerData && !fileManagerLoading && !fileManagerError"
              class="fm-placeholder"
            >
              Pilih tombol <strong>Explore</strong> pada volume atau mount point untuk membuka File Explorer.
            </div>

            <div v-if="fileManagerLoading && !fileManagerData" class="fm-placeholder">
              Membuka direktori...
            </div>

            <template v-if="fileManagerData">
              <div class="fm-toolbar">
                <div class="fm-breadcrumb">
                  <template
                    v-for="(crumb, index) in fileManagerBreadcrumbs"
                    :key="crumb.path"
                  >
                    <button
                      type="button"
                      class="fm-crumb"
                      :class="{ 'fm-crumb-active': index === fileManagerBreadcrumbs.length - 1 }"
                      :disabled="index === fileManagerBreadcrumbs.length - 1 || fileManagerLoading"
                      @click="loadRemoteFiles(crumb.path)"
                    >
                      {{ crumb.label }}
                    </button>
                    <span
                      v-if="index < fileManagerBreadcrumbs.length - 1"
                      class="fm-crumb-separator"
                    >/</span>
                  </template>
                </div>

                <div class="fm-explorer-actions">
                  <button
                    v-if="fileManagerData.parent_path"
                    type="button"
                    class="fm-button fm-secondary"
                    :disabled="fileManagerLoading || fileManagerActionLoading"
                    @click="loadRemoteFiles(fileManagerData.parent_path)"
                  >
                    ↑ Parent
                  </button>
                  <button
                    type="button"
                    class="fm-button fm-secondary"
                    :disabled="!fileManagerCanModifyCurrentPath || fileManagerActionLoading"
                    @click="createRemoteFolder"
                  >
                    + New Folder
                  </button>
                </div>
              </div>

              <div class="fm-current-path">
                <span>Current path</span>
                <code>{{ fileManagerData.current_path }}</code>
                <span>{{ fileManagerData.total_items }} item</span>
                <span v-if="fileManagerData.read_only" class="fm-readonly-label">
                  Read Only · OS
                </span>
              </div>

              <div v-if="fileManagerActionError" class="fm-error" role="alert">
                {{ fileManagerActionError }}
              </div>
              <div v-if="fileManagerActionMessage" class="fm-success" role="status">
                {{ fileManagerActionMessage }}
              </div>

              <div v-if="fileManagerLoading" class="fm-placeholder">
                Membaca direktori...
              </div>

              <div v-else-if="fileManagerItems.length === 0" class="fm-placeholder">
                Direktori ini masih kosong.
              </div>

              <div v-else class="fm-table-wrap">
                <table class="fm-table">
                  <thead>
                    <tr>
                      <th>Nama</th>
                      <th>Tipe</th>
                      <th>Ukuran</th>
                      <th>Modified</th>
                      <th>Permission</th>
                      <th>Aksi</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr v-for="item in fileManagerItems" :key="item.path">
                      <td class="fm-name-cell">
                        <span class="fm-file-icon">
                          {{ item.type === 'directory' ? '📁' : item.type === 'file' ? '📄' : '⚠️' }}
                        </span>
                        <span class="fm-name">{{ item.name }}</span>
                      </td>
                      <td>{{ item.is_symlink ? 'Symlink' : item.type }}</td>
                      <td>{{ item.size === null ? '-' : formatBytes(item.size) }}</td>
                      <td>{{ formatRemoteDate(item.modified_at) }}</td>
                      <td><code>{{ item.permissions || '-' }}</code></td>
                      <td>
                        <div class="fm-explorer-actions">
                          <button
                            v-if="item.type === 'directory' && !item.is_symlink"
                            type="button"
                            class="fm-action"
                            :disabled="fileManagerLoading || fileManagerActionLoading"
                            @click="openRemoteDirectory(item)"
                          >
                            Buka
                          </button>
                          <button
                            v-if="item.type === 'file' && !item.is_symlink"
                            type="button"
                            class="fm-action"
                            :disabled="!fileManagerCanModifyCurrentPath"
                            @click="downloadRemoteFile(item)"
                          >
                            Download
                          </button>
                          <button
                            v-if="item.type !== 'special' && !item.is_symlink"
                            type="button"
                            class="fm-action"
                            :disabled="fileManagerActionLoading || !fileManagerCanModifyCurrentPath"
                            @click="renameRemoteEntry(item)"
                          >
                            Rename
                          </button>
                          <button
                            v-if="item.type !== 'special'"
                            type="button"
                            class="fm-action fm-action-danger"
                            :disabled="fileManagerActionLoading || !fileManagerCanModifyCurrentPath"
                            @click="deleteRemoteEntry(item)"
                          >
                            Hapus
                          </button>
                        </div>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>

              <div v-if="!fileManagerData.read_only" class="fm-upload">
                <div>
                  <h3>Upload File</h3>
                  <p>Ukuran maksimum 100 MB. File yang sudah ada tidak akan ditimpa.</p>
                </div>

                <div class="fm-upload-controls">
                  <input
                    id="file-manager-upload-input"
                    type="file"
                    class="fm-file-input"
                    :disabled="fileManagerUploading || fileManagerActionLoading || !fileManagerCanModifyCurrentPath"
                    @change="handleUploadSelection"
                  />
                  <button
                    type="button"
                    class="fm-button fm-primary"
                    :disabled="!selectedUploadFile || fileManagerUploading || fileManagerActionLoading || !fileManagerCanModifyCurrentPath"
                    @click="uploadRemoteFile"
                  >
                    {{ fileManagerUploading ? 'Mengunggah...' : '↑ Upload' }}
                  </button>
                </div>

                <p v-if="selectedUploadFile" class="fm-file-selection">
                  {{ selectedUploadFile.name }} · {{ formatBytes(selectedUploadFile.size) }}
                </p>
                <p v-if="fileManagerUploadMessage" class="fm-success" role="status">
                  {{ fileManagerUploadMessage }}
                </p>
                <p v-if="fileManagerUploadError" class="fm-error" role="alert">
                  {{ fileManagerUploadError }}
                </p>
              </div>

              <div v-else class="fm-placeholder">
                Filesystem root OS dalam mode Read Only. Upload, download,
                rename, delete, dan pembuatan folder dinonaktifkan.
              </div>
            </template>
          </section>
        </section>
        <!-- STORAGE FORMAT DIALOG -->
        <Teleport to="body">
          <div
            v-if="formatDialogOpen"
            class="fm-format-overlay"
            @click.self="closeStorageFormatDialog"
          >
            <section
              class="fm-format-dialog"
              role="dialog"
              aria-modal="true"
              aria-labelledby="fm-format-title"
            >
              <div class="fm-format-heading">
                <div>
                  <h2 id="fm-format-title">Initialize & Format Disk</h2>
                  <p>Periksa perangkat sebelum melanjutkan.</p>
                </div>
                <button
                  type="button"
                  class="fm-format-close"
                  :disabled="formatPreflightLoading || formatExecuting"
                  aria-label="Tutup dialog"
                  @click="closeStorageFormatDialog"
                >
                  ×
                </button>
              </div>

              <div v-if="formatTargetDevice" class="fm-format-device">
                <div>
                  <span>Perangkat</span>
                  <strong>{{ formatTargetDevice.path }}</strong>
                </div>
                <div>
                  <span>Model</span>
                  <strong>{{ formatPreflight?.device?.model || formatTargetDevice.model || 'Unknown' }}</strong>
                </div>
                <div>
                  <span>Kapasitas</span>
                  <strong>
                    {{ formatPreflight?.device?.size_bytes
                      ? `${(Number(formatPreflight.device.size_bytes) / 1073741824).toFixed(2)} GB`
                      : (formatTargetDevice.size || '-') }}
                  </strong>
                </div>
                <div>
                  <span>Serial</span>
                  <strong>{{ formatPreflight?.device?.serial || '-' }}</strong>
                </div>
              </div>

              <div v-if="formatPreflightLoading" class="fm-format-notice">
                Memeriksa keamanan dan kelayakan perangkat melalui SSH...
              </div>

              <div v-if="formatPreflightError" class="fm-format-error" role="alert">
                {{ formatPreflightError }}
              </div>

              <div v-if="formatError" class="fm-format-error" role="alert">
                {{ formatError }}
              </div>

              <div v-if="formatSuccess" class="fm-format-notice is-safe" role="status">
                {{ formatSuccess }}
              </div>

              <template v-if="formatPreflight && !formatPreflightLoading">
                <div
                  class="fm-format-notice"
                  :class="formatPreflight.eligible ? 'is-safe' : 'is-blocked'"
                >
                  <strong>
                    {{ formatPreflight.eligible
                      ? 'Pemeriksaan awal berhasil'
                      : 'Perangkat tidak memenuhi syarat' }}
                  </strong>
                  <span>
                    {{ formatPreflight.eligible
                      ? 'Disk terdeteksi sebagai perangkat kosong dan tidak sedang digunakan.'
                      : 'Disk tidak dapat diproses. Periksa alasan di bawah.' }}
                  </span>
                </div>

                <ul
                  v-if="Array.isArray(formatPreflight.reasons) && formatPreflight.reasons.length"
                  class="fm-format-reasons"
                >
                  <li v-for="(reason, index) in formatPreflight.reasons" :key="index">
                    {{ reason }}
                  </li>
                </ul>

                <div v-if="formatPreflight.eligible" class="fm-format-options">
                  <label>
                    Filesystem
                    <select v-model="formatFilesystem">
                      <option
                        v-for="filesystem in formatPreflight.supported_filesystems || []"
                        :key="filesystem"
                        :value="filesystem"
                      >
                        {{ filesystem.toUpperCase() }}
                      </option>
                    </select>
                  </label>

                  <label>
                    Label filesystem (opsional)
                    <input
                      v-model="formatLabel"
                      type="text"
                      maxlength="12"
                      placeholder="Contoh: DATA01"
                      autocomplete="off"
                    >
                  </label>

                  <label>
                    Ketik path perangkat untuk konfirmasi
                    <input
                      v-model="formatTypedConfirmation"
                      type="text"
                      :placeholder="formatTargetDevice?.path || '/dev/sdb'"
                      autocomplete="off"
                      spellcheck="false"
                    >
                  </label>

                  <p class="fm-format-warning">
                    <strong>PERINGATAN:</strong>
                    proses inisialisasi nantinya akan membuat tabel partisi GPT,
                    satu partisi menggunakan seluruh kapasitas disk, lalu membuat
                    filesystem. Seluruh data dan partisi lama pada perangkat
                    target akan hilang.
                  </p>
                </div>
              </template>

              <div class="fm-format-actions">
                <button
                  type="button"
                  class="fm-button fm-secondary"
                  :disabled="formatPreflightLoading || formatExecuting"
                  @click="closeStorageFormatDialog"
                >
                  Tutup
                </button>
                <button
                  type="button"
                  class="fm-button fm-secondary"
                  :disabled="formatPreflightLoading || formatExecuting || formatCompleted"
                  @click="inspectStorageFormat"
                >
                  {{ formatPreflightLoading ? 'Memeriksa...' : '↻ Periksa Ulang' }}
                </button>

                <button
                  v-if="formatPreflight?.eligible && !formatCompleted"
                  type="button"
                  class="fm-button fm-format-button"
                  :disabled="formatPreflightLoading || formatExecuting || formatTypedConfirmation !== formatTargetDevice?.path"
                  @click="executeStorageFormat"
                >
                  {{ formatExecuting ? 'Memformat disk...' : 'Format Disk' }}
                </button>
              </div>
            </section>
          </div>
        </Teleport>
        <!-- STORAGE FORMAT DIALOG END -->

        <!-- FILE_MANAGER_TEMPLATE_END -->

<section v-if="!editing" class="connection-panel">
          <div class="connection-heading">
            <div>
              <h2>SSH Connection & Host Verification</h2>
              <p>
                Discover fingerprint dan uji autentikasi SSH server.
              </p>
            </div>

            <span
              v-if="server.connection_protocol === 'winrm'"
              class="protocol-note"
            >
              WinRM belum didukung
            </span>
          </div>

          <div class="connection-actions">
            <button
              v-if="['ssh', 'windows_openssh'].includes(server.connection_protocol)"
              type="button"
              class="secondary-action"
              :disabled="discoveringHostKey || testingConnection"
              @click="discoverHostKey"
            >
              {{ discoveringHostKey ? 'Discovering...' : 'Discover Host Key' }}
            </button>

            <button
              v-if="['ssh', 'windows_openssh'].includes(server.connection_protocol)"
              type="button"
              class="primary-action"
              :disabled="testingConnection || discoveringHostKey"
              @click="testConnection"
            >
              {{ testingConnection ? 'Testing...' : 'Test SSH Connection' }}
            </button>

            <button
              type="button"
              class="secondary-action"
              @click="editing = true; connectionError = ''; connectionMessage = ''"
            >
              Edit Configuration
            </button>
          </div>

          <div v-if="hostKeyCandidate" class="fingerprint-candidate">
            <h3>Discovered Host Key</h3>

            <div class="candidate-detail">
              <span>Key Algorithm</span>
              <strong>{{ hostKeyCandidate.key_type }}</strong>
            </div>

            <div class="candidate-detail">
              <span>SHA256 Fingerprint</span>
              <code>{{ hostKeyCandidate.fingerprint }}</code>
            </div>

            <p class="security-warning">
              Jangan percaya fingerprint hanya karena berhasil diambil dari
              jaringan. Bandingkan dengan fingerprint yang diperoleh langsung
              dari server melalui console atau jalur tepercaya.
            </p>

            <label class="trust-confirmation">
              <input v-model="fingerprintTrusted" type="checkbox" />
              <span>
                Saya sudah membandingkan fingerprint ini melalui jalur
                tepercaya dan memastikan nilainya cocok.
              </span>
            </label>

            <button
              type="button"
              class="primary-action"
              :disabled="!fingerprintTrusted"
              @click="useDiscoveredFingerprint"
            >
              Use Verified Fingerprint
            </button>
          </div>

          <p v-if="connectionMessage" class="connection-success" role="status">
            {{ connectionMessage }}
          </p>

          <p v-if="connectionError" class="connection-error" role="alert">
            {{ connectionError }}
          </p>

          <p
            v-if="!server.verify_host_key"
            class="security-warning"
          >
            Peringatan: verifikasi host key dinonaktifkan. Identitas server
            tidak diperiksa sebelum autentikasi.
          </p>

          <p
            v-else-if="!server.host_key_fingerprint"
            class="security-warning"
          >
            Host key belum terdaftar. Test Connection akan ditolak sampai
            fingerprint diverifikasi dan disimpan.
          </p>
        </section>

        <section class="configuration">
          <div class="section-heading">
            <div>
              <h2>Server Configuration</h2>
              <p>Informasi konfigurasi server yang tersimpan.</p>
            </div>

            <button
              v-if="!editing"
              class="edit-button"
              @click="editing = true"
            >
              ✎ Edit Server
            </button>
          </div>

          <div v-if="!editing" class="details">
            <div class="detail-item">
              <span>Server Name</span>
              <strong>{{ server.name }}</strong>
            </div>

            <div class="detail-item">
              <span>IP Address</span>
              <strong>{{ server.ip_address || '-' }}</strong>
            </div>

            <div class="detail-item">
              <span>Hostname / FQDN</span>
              <strong>{{ server.hostname || '-' }}</strong>
            </div>

            <div class="detail-item">
              <span>Operating System</span>
              <strong>{{ server.os_type }}</strong>
            </div>

            <div class="detail-item">
              <span>Connection Protocol</span>
              <strong>{{ protocolLabel }}</strong>
            </div>

            <div class="detail-item">
              <span>Port</span>
              <strong>{{ server.port }}</strong>
            </div>

            <div class="detail-item">
              <span>Username</span>
              <strong>{{ server.username }}</strong>
            </div>

            <div class="detail-item">
              <span>Authentication</span>
              <strong>{{ authLabel }}</strong>
            </div>

            <div class="detail-item">
              <span>Host Key Verification</span>
              <strong>
                {{ server.connection_protocol === 'winrm'
                  ? 'Not applicable'
                  : server.verify_host_key ? 'Enabled' : 'Disabled' }}
              </strong>
            </div>

            <div class="detail-item">
              <span>Host Key Fingerprint</span>
              <strong>{{ server.host_key_fingerprint || '-' }}</strong>
            </div>

            <div class="detail-item">
              <span>Created At</span>
              <strong>{{ formatDate(server.created_at) }}</strong>
            </div>

            <div class="detail-item">
              <span>Last Updated</span>
              <strong>{{ formatDate(server.updated_at) }}</strong>
            </div>

            <div class="detail-item full">
              <span>NOTES</span>
              <strong class="notes">
                {{ server.notes || 'Tidak ada catatan.' }}
              </strong>
            </div>
          </div>

          <form v-else class="edit-form" @submit.prevent="saveChanges">
            <div class="form-section">
              <h3>01. Server Information</h3>

              <div class="fields">
                <label class="field full">
                  <span>Server Name *</span>
                  <input v-model.trim="form.name" required maxlength="100" />
                  <small v-if="fieldErrors.name" class="field-error">{{ fieldErrors.name[0] }}</small>
                </label>

                <label class="field">
                  <span>IP Address</span>
                  <input v-model.trim="form.ip_address" placeholder="192.168.1.10" />
                  <small v-if="fieldErrors.ip_address" class="field-error">{{ fieldErrors.ip_address[0] }}</small>
                </label>

                <label class="field">
                  <span>Hostname / FQDN</span>
                  <input v-model.trim="form.hostname" placeholder="server.example.com" />
                </label>

                <label class="field">
                  <span>Operating System *</span>
                  <select v-model="form.os_type">
                    <option value="linux">Linux</option>
                    <option value="windows">Windows Server</option>
                  </select>
                </label>

                <label class="field">
                  <span>Connection Protocol *</span>
                  <select v-model="form.connection_protocol">
                    <option v-if="form.os_type === 'linux'" value="ssh">SSH</option>
                    <template v-else>
                      <option value="winrm">WinRM</option>
                      <option value="windows_openssh">Windows OpenSSH</option>
                    </template>
                  </select>
                  <small v-if="fieldErrors.connection_protocol" class="field-error">{{ fieldErrors.connection_protocol[0] }}</small>
                </label>

                <label class="field">
                  <span>Port *</span>
                  <input v-model.number="form.port" type="number" min="1" max="65535" required />
                </label>

                <label class="field">
                  <span>Username *</span>
                  <input v-model.trim="form.username" required maxlength="100" />
                </label>
              </div>
            </div>

            <div class="form-section">
              <h3>02. Authentication</h3>
              <p class="section-description">
                Credential tersimpan tidak ditampilkan. Kosongkan credential jika tidak ingin menggantinya.
              </p>

              <div class="fields">
                <label class="field full">
