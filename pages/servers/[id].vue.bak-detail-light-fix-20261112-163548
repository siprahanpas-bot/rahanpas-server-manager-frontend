.fm-format-overlay { position:fixed; inset:0; z-index:10000; display:flex; align-items:center; justify-content:center; padding:18px; background:rgba(2,6,23,.82); backdrop-filter:blur(4px); }
.fm-format-dialog { width:min(100%,560px); max-height:calc(100vh - 36px); overflow-y:auto; padding:21px; border:1px solid #475569; border-radius:13px; background:#0f172a; color:#e2e8f0; box-shadow:0 24px 70px rgba(0,0,0,.55); }
