}

.aa-table th.aa-sortable {
  cursor: pointer;
}

.aa-table th.aa-sortable:hover {
  color: var(--text-bright);
}

.aa-sort-ind {
  margin-left: 4px;
  opacity: 0.7;
  font-size: 10px;
}

.aa-table td {
  padding: 8px 14px;
  border-bottom: 1px solid var(--border-subtle);
  color: var(--text-soft);
  white-space: nowrap;
}

.aa-table tbody tr:hover {
  background: var(--surface-hover);
}

.aa-entry-btn,
.aa-entry-static {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 0;
  padding: 2px 0;
  background: transparent;
  color: var(--text-bright);
  font-size: 12px;
  font-weight: 500;
  text-align: left;
}

.aa-entry-btn {
  cursor: pointer;
}

.aa-entry-btn:hover .aa-entry-name {
  color: var(--primary-text);
  text-decoration: underline;
}

.aa-file-ico {
  font-size: 15px;
  line-height: 1;
}

.aa-type-pill {
  font-size: 11px;
  color: var(--text-muted);
  text-transform: capitalize;
}

.aa-pmsn {
  padding: 2px 6px;
  border-radius: 5px;
  background: var(--surface-muted);
  border: 1px solid var(--border);
  font-size: 11px;
  color: var(--text-secondary);
}

.aa-num {
  font-variant-numeric: tabular-nums;
  color: var(--text-secondary);
}

.aa-op-col {
  text-align: right;
}

.aa-op-links {
  display: inline-flex;
  align-items: center;
  gap: 10px;
}

.aa-op-links button {
  border: 0;
  padding: 2px 4px;
  background: transparent;
  color: var(--primary-text);
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
}

.aa-op-links button:hover:not(:disabled) {
  text-decoration: underline;
}

.aa-op-links button.danger {
  color: var(--danger-text);
}

.aa-op-links button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.aa-grid-view {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 12px;
  padding: 14px;
}

.aa-grid-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface-raised);
  overflow: hidden;
}

.aa-grid-card:hover {
  border-color: var(--primary);
}

.aa-grid-main {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6px;
  padding: 14px 10px 10px;
  border: 0;
  background: transparent;
  color: var(--text-bright);
  cursor: pointer;
  text-align: center;
}

.aa-grid-main:disabled {
  cursor: default;
}

.aa-grid-ico {
  font-size: 28px;
  line-height: 1;
}

.aa-grid-main strong {
  width: 100%;
  font-size: 12px;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aa-grid-main small {
  font-size: 10px;
  color: var(--text-muted);
}

.aa-grid-actions {
  display: flex;
  justify-content: center;
  gap: 8px;
  padding: 6px 8px;
  border-top: 1px solid var(--border-subtle);
  background: var(--surface-muted);
}

.aa-grid-actions button {
  border: 0;
  padding: 2px 4px;
  background: transparent;
  color: var(--primary-text);
  font-size: 10px;
  font-weight: 600;
  cursor: pointer;
}

.aa-grid-actions button.danger {
  color: var(--danger-text);
}

.aa-grid-actions button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.aa-footer-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding: 10px 14px;
  border-top: 1px solid var(--border-subtle);
  background: var(--surface-muted);
  color: var(--text-secondary);
  font-size: 11px;
  flex-wrap: wrap;
}

.aa-footer-path {
  color: var(--text-muted);
  word-break: break-all;
}

@media (max-width: 640px) {
  .aa-path-bar,
  .aa-action-bar {
    padding: 10px;
  }

  .aa-search-box {
    flex: 1 1 100%;
  }

  .aa-grid-view {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
    padding: 10px;
  }
}

/* === Responsive Image Lightbox Preview === */
.aa-lightbox-overlay {
  position: fixed;
  inset: 0;
  z-index: 1300;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16px;
  background: rgba(2, 6, 23, 0.84);
  backdrop-filter: blur(6px);
}

.aa-lightbox {
  width: 100%;
  max-width: 1040px;
  height: 88dvh;
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border-strong);
  border-radius: 16px;
  background: var(--surface);
  color: var(--text);
  overflow: hidden;
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.55);
}

.aa-lightbox-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 12px 16px;
  border-bottom: 1px solid var(--border-subtle);
  background: var(--surface-raised);
  flex-wrap: wrap;
}

.aa-lightbox-meta {
  min-width: 0;
  flex: 1 1 200px;
}

.aa-lightbox-meta strong {
  display: block;
  font-size: 13px;
  color: var(--text-bright);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.aa-lightbox-meta small {
  display: block;
  margin-top: 2px;
  font-size: 11px;
  color: var(--text-muted);
}

.aa-lightbox-tools {
  display: flex;
  align-items: center;
  gap: 6px;
  flex-wrap: wrap;
}

.aa-lightbox-tools button {
  height: 32px;
  padding: 0 10px;
  border: 1px solid var(--border-strong);
  border-radius: 8px;
  background: var(--surface-muted);
  color: var(--text);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.aa-lightbox-tools button:hover:not(:disabled) {
  border-color: var(--primary);
  color: var(--primary-text);
}

.aa-lightbox-tools button:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.aa-lightbox-tools .aa-lb-dl {
  border-color: var(--primary);
  background: var(--primary);
  color: #ffffff;
}

.aa-lightbox-tools .aa-lb-dl:hover {
  color: #ffffff;
  opacity: 0.92;
}

.aa-lightbox-tools .aa-lb-close {
  width: 32px;
  padding: 0;
  font-size: 18px;
}

.aa-lightbox-stage {
  position: relative;
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at center, rgba(148, 163, 184, 0.08), transparent 70%),
    var(--app-bg);
  overflow: auto;
  padding: 20px;
}

.aa-lb-canvas {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  max-height: 100%;
}

.aa-lb-canvas img {
  max-width: 100%;
  max-height: calc(88dvh - 110px);
  object-fit: contain;
  border-radius: 8px;
  transition: transform 0.2s ease;
  box-shadow: 0 12px 36px rgba(0, 0, 0, 0.35);
}

.aa-lb-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 5;
  width: 40px;
  height: 40px;
  display: grid;
  place-items: center;
  border: 1px solid var(--border-strong);
  border-radius: 50%;
  background: var(--surface);
  color: var(--text-bright);
  font-size: 22px;
  cursor: pointer;
  opacity: 0.88;
}

.aa-lb-nav:hover {
  opacity: 1;
  border-color: var(--primary);
}

.aa-lb-nav.prev { left: 14px; }
.aa-lb-nav.next { right: 14px; }

.aa-lb-state {
  font-size: 13px;
  color: var(--text-secondary);
  text-align: center;
}

.aa-lb-state.is-error {
  color: var(--danger-text);
}

@media (max-width: 640px) {
  .aa-lightbox-overlay {
    padding: 0;
  }

  .aa-lightbox {
    height: 100dvh;
    border-radius: 0;
    border: 0;
  }

  .aa-lightbox-header {
    padding: 10px 12px;
  }

  .aa-lb-canvas img {
    max-height: calc(100dvh - 140px);
  }

  .aa-lb-nav {
    width: 34px;
    height: 34px;
    font-size: 18px;
  }

  .aa-lb-nav.prev { left: 8px; }
  .aa-lb-nav.next { right: 8px; }
}

/* === Modern Interactive Monitoring History Charts === */
.modern-chart-card {
  padding: 16px !important;
  border: 1px solid var(--border) !important;
  border-radius: 14px !important;
  background: var(--surface-raised) !important;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.chart-title-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.chart-dot-legend {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  flex-shrink: 0;
}

.chart-live-value {
  text-align: right;
  flex-shrink: 0;
}

.chart-live-value strong {
  display: block;
  font-size: 18px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
}

.chart-live-value small {
  display: block;
  margin-top: 2px;
  font-size: 10px;
  color: var(--text-muted);
}

.chart-inspector-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 7px 10px;
  border-radius: 8px;
  background: var(--surface-muted);
  border: 1px solid var(--border-subtle);
  font-size: 11px;
  color: var(--text-secondary);
  flex-wrap: wrap;
}

.chart-inspector-bar b {
  color: var(--text-bright);
  font-variant-numeric: tabular-nums;
}

.chart-minmax {
  font-variant-numeric: tabular-nums;
  color: var(--text-muted);
  font-size: 10px;
}

.modern-svg-wrap {
  position: relative;
  width: 100%;
  touch-action: pan-y;
}

.modern-svg {
  width: 100%;
  height: 170px;
  display: block;
  cursor: crosshair;
  overflow: visible;
}

.modern-svg .chart-grid-line.dashed {
  stroke-dasharray: 4 4;
  opacity: 0.65;
}

.chart-y-label {
  fill: var(--text-muted);
  font-size: 9px;
  font-variant-numeric: tabular-nums;
}

.modern-svg .history-chart-line {
  fill: none;
  stroke-width: 2.4;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.chart-crosshair {
  stroke: var(--text-muted);
  stroke-width: 1.2;
  stroke-dasharray: 3 3;
  opacity: 0.85;
}

.chart-active-ring {
  fill: var(--surface);
  stroke-width: 2.8;
}

@media (max-width: 640px) {
  .modern-chart-card {
    padding: 13px !important;
  }

  .modern-svg {
    height: 145px;
  }
}

/* === Modern & Responsive Danger Zone === */
.modern-danger-zone {
  margin-top: 24px;
  margin-bottom: 56px;
  padding: 20px 22px;
  border: 1px solid var(--danger-border);
  border-left: 4px solid #dc2626;
  border-radius: 14px;
  background: var(--danger-bg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.modern-danger-zone .dz-info {
  display: flex;
  align-items: flex-start;
  gap: 14px;
  min-width: 0;
}

.modern-danger-zone .dz-icon {
  width: 36px;
  height: 36px;
  flex-shrink: 0;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: rgba(220, 38, 38, 0.16);
  color: #ef4444;
  font-size: 16px;
  font-weight: 700;
}

.modern-danger-zone h2 {
  margin: 0;
  font-size: 15px;
  font-weight: 700;
  color: var(--danger-text);
}

.modern-danger-zone p {
  margin: 5px 0 0;
  font-size: 12px;
  line-height: 1.6;
  color: var(--text-secondary);
  max-width: 620px;
}

.modern-danger-zone .dz-delete-btn {
  flex-shrink: 0;
  padding: 10px 16px;
  border: 1px solid #dc2626;
  border-radius: 10px;
  background: #dc2626;
  color: #ffffff;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.modern-danger-zone .dz-delete-btn:hover:not(:disabled) {
  background: #b91c1c;
  border-color: #b91c1c;
}

.modern-danger-zone .dz-delete-btn:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

@media (max-width: 640px) {
  .modern-danger-zone {
    flex-direction: column;
    align-items: stretch;
    padding: 16px;
    gap: 14px;
  }

  .modern-danger-zone .dz-delete-btn {
    width: 100%;
    text-align: center;
  }
}

/* === Modern & User-Friendly Storage Devices & Mount Points === */
.fm-panel {
  margin-top: 20px;
  padding: 24px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: 0 10px 30px rgba(2, 6, 23, 0.14);
}

.fm-storage-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 14px;
  padding-bottom: 16px;
  margin-bottom: 18px;
  border-bottom: 1px solid var(--border-subtle);
  flex-wrap: wrap;
}

.fm-storage-heading h3 {
  margin: 0;
  font-size: 17px;
  font-weight: 700;
  color: var(--text-bright);
}

.fm-storage-heading p {
  margin: 5px 0 0;
  font-size: 12px;
  color: var(--text-secondary);
}

.fm-storage-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(235px, 1fr));
  gap: 14px;
}

.fm-storage-card {
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface-raised);
  display: flex;
  flex-direction: column;
  gap: 8px;
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.fm-storage-card:hover {
  border-color: var(--primary);
  transform: translateY(-2px);
}

.fm-storage-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}

.fm-storage-top strong {
  font-size: 14px;
  font-weight: 700;
  color: var(--text-bright);
  word-break: break-all;
}

.fm-storage-top span {
  padding: 2px 8px;
  border-radius: 999px;
  border: 1px solid var(--border-strong);
  background: var(--surface-muted);
  color: var(--text-secondary);
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  flex-shrink: 0;
}

.fm-storage-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 11px;
  color: var(--text-secondary);
  font-variant-numeric: tabular-nums;
}

.fm-storage-meta strong {
  color: var(--text-bright);
  font-weight: 700;
}

.fm-storage-bar {
  height: 7px;
  border-radius: 999px;
  background: var(--surface-muted);
  overflow: hidden;
  margin-top: 2px;
}

.fm-storage-bar > div {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #2563eb, #38bdf8);
  transition: width 0.4s ease;
}

.fm-devices-panel {
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid var(--border-subtle);
}

.fm-devices-panel h4 {
  margin: 0 0 12px;
  font-size: 13px;
  font-weight: 700;
  color: var(--text-bright);
}

.fm-devices-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.fm-device-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  padding: 14px 16px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface-raised);
  flex-wrap: wrap;
}

.fm-device-row:hover {
  border-color: var(--border-strong);
}

.fm-device-info {
  min-width: 0;
  flex: 1 1 280px;
}

.fm-device-title {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.fm-device-title strong {
  font-size: 13px;
  font-weight: 700;
  color: var(--text-bright);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.fm-device-info small {
  display: block;
  margin-top: 5px;
  font-size: 11px;
  color: var(--text-secondary);
}

.fm-device-badge {
  padding: 2px 8px;
  border-radius: 999px;
  font-size: 10px;
  font-weight: 700;
  border: 1px solid var(--border-strong);
  background: var(--surface-muted);
  color: var(--text-secondary);
}

.fm-device-badge.fm-device-root {
  border-color: rgba(59, 130, 246, 0.35);
  background: rgba(59, 130, 246, 0.14);
  color: var(--primary-text);
}

.fm-device-badge.fm-device-mounted {
  border-color: rgba(34, 197, 94, 0.35);
  background: var(--success-bg);
  color: var(--success-text);
}

.fm-device-badge.fm-device-unmounted {
  border-color: rgba(245, 158, 11, 0.35);
  background: rgba(245, 158, 11, 0.14);
  color: var(--warning-text);
}

.fm-device-actions {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.fm-device-actions .fm-button {
  padding: 7px 12px;
  border-radius: 8px;
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
}

.fm-device-actions .fm-format-trigger {
  border: 1px solid rgba(245, 158, 11, 0.45);
  background: rgba(245, 158, 11, 0.14);
  color: var(--warning-text);
}

.fm-device-actions .fm-danger {
  border: 1px solid var(--danger-border);
  background: var(--danger-bg);
  color: var(--danger-text);
}

@media (max-width: 640px) {
  .fm-panel {
    padding: 16px;
    border-radius: 14px;
  }

  .fm-storage-grid {
    grid-template-columns: 1fr;
  }

  .fm-device-row {
    padding: 12px;
    flex-direction: column;
    align-items: stretch;
  }

  .fm-device-actions {
    width: 100%;
  }

  .fm-device-actions .fm-button {
    flex: 1 1 auto;
    text-align: center;
  }
}

/* === Sleek Capacity Bar inside each Drive Card (sda, sdb, etc.) === */
.fm-drive-capacity {
  margin-top: 12px;
  padding-top: 12px;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.fm-drive-cap-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  font-size: 11px;
}

.fm-drive-cap-head span {
  color: var(--text-muted);
  font-weight: 600;
}

.fm-drive-cap-head strong {
  font-variant-numeric: tabular-nums;
  font-weight: 700;
  color: var(--text-bright);
}

.fm-drive-cap-head strong.healthy { color: var(--primary-text); }
.fm-drive-cap-head strong.warning { color: var(--warning-text); }
.fm-drive-cap-head strong.critical { color: var(--danger-text); }
.fm-drive-cap-head strong.idle { color: var(--text-muted); font-weight: 600; }

.fm-drive-cap-track {
  height: 9px;
  border-radius: 999px;
  background: var(--surface-muted);
  overflow: hidden;
}

.fm-drive-cap-fill {
  height: 100%;
  border-radius: 999px;
  transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1);
