}

.aa-btn {
  padding: 7px 12px;
  border: 1px solid var(--border-strong);
  border-radius: 8px;
  background: var(--surface-raised);
  color: var(--text);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.aa-btn:hover:not(:disabled) {
  border-color: var(--primary);
  color: var(--primary-text);
}

.aa-btn-primary {
  border-color: var(--primary);
  background: var(--primary);
  color: #ffffff;
}

.aa-btn-primary:hover:not(:disabled) {
  opacity: 0.92;
  color: #ffffff;
}

.aa-btn:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

.aa-readonly-badge {
  padding: 4px 9px;
  border-radius: 999px;
  border: 1px solid rgba(245, 158, 11, 0.35);
  background: rgba(245, 158, 11, 0.12);
  color: var(--warning-text);
  font-size: 11px;
  font-weight: 600;
}

.aa-view-toggle {
  display: inline-flex;
  border: 1px solid var(--border-strong);
  border-radius: 8px;
  overflow: hidden;
  background: var(--surface-muted);
}

.aa-view-toggle button {
  padding: 6px 10px;
  border: 0;
  background: transparent;
  color: var(--text-secondary);
  font-size: 14px;
  cursor: pointer;
}

.aa-view-toggle button.active {
  background: var(--primary);
  color: #ffffff;
}

.aa-alert {
  margin: 10px 14px;
}

.aa-table-wrap {
  width: 100%;
  overflow-x: auto;
}

.aa-table {
  width: 100%;
  min-width: 720px;
  border-collapse: collapse;
  font-size: 12px;
  text-align: left;
}

.aa-table th {
  padding: 10px 14px;
  background: var(--surface-muted);
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 700;
  border-bottom: 1px solid var(--border);
  white-space: nowrap;
