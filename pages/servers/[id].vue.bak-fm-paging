                      :style="{ stroke: chartThemeColor(chart.key) }"
                    />

                    <line
                      v-if="inspectedHistoryIndex >= 0"
                      :x1="historyX(inspectedHistoryIndex)"
                      y1="16"
                      :x2="historyX(inspectedHistoryIndex)"
                      y2="164"
                      class="chart-crosshair"
                    />

                    <circle
                      v-if="inspectedHistoryIndex >= 0"
                      :cx="historyX(inspectedHistoryIndex)"
                      :cy="historyNetworkY(historyNetworkRate(inspectedHistoryIndex, chart.key))"
                      r="5.5"
                      class="chart-active-ring"
                      :style="{ stroke: chartThemeColor(chart.key) }"
                    />
                  </svg>
                </div>

                <div class="history-chart-axis">
                  <span>{{ formatHistoryTime(historyPoints[0].collected_at) }}</span>
                  <span v-if="historyPoints.length > 2">
