}

:global(html[data-theme="light"]) .status-online {
  color: #166534 !important;
  background: #dcfce7 !important;
}

:global(html[data-theme="light"]) .status-offline,
:global(html[data-theme="light"]) .status-error {
  color: #991b1b !important;
  background: #fee2e2 !important;
}

:global(html[data-theme="light"]) .status-unknown {
  color: var(--text-muted) !important;
  background: var(--text) !important;
}

:global(html[data-theme="light"]) .danger-zone {
  background: #fff1f2 !important;
  border-color: #fecdd3 !important;
}

:global(html[data-theme="light"]) .danger-zone h2 {
  color: #be123c !important;
}

:global(html[data-theme="light"]) .danger-zone p {
  color: var(--text-muted) !important;
}



/* MONITORING PANEL COMPLETE THEME V2 */

/* DARK THEME - DEFAULT */
.monitoring-panel {
  margin-top: 24px;
  padding: 24px;
  border: 1px solid var(--border);
  border-radius: 16px;
  background: var(--surface);
  box-shadow: 0 10px 30px rgba(2, 6, 23, 0.14);
}

.monitoring-panel .monitoring-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding-bottom: 18px;
  margin-bottom: 18px;
  border-bottom: 1px solid var(--border-subtle);
}

.monitoring-panel .monitoring-title-row {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.monitoring-panel .monitoring-heading h2 {
  margin: 0;
  font-size: 17px;
  font-weight: 700;
  color: var(--text-bright);
}

.monitoring-panel .monitoring-heading p {
  margin: 6px 0 0;
  font-size: 12px;
  color: var(--text-secondary);
}

.monitoring-panel .live-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  border-radius: 999px;
  border: 1px solid var(--border-strong);
  background: var(--surface-muted);
  color: var(--text-secondary);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.06em;
}

.monitoring-panel .live-pill i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--text-muted);
}

.monitoring-panel .live-pill.active {
  border-color: rgba(34, 197, 94, 0.35);
  background: rgba(34, 197, 94, 0.12);
  color: var(--success-text);
}

.monitoring-panel .live-pill.active i {
  background: #22c55e;
  box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.25);
  animation: livePulse 1.8s infinite;
}

@keyframes livePulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.5; transform: scale(0.85); }
}

.monitoring-panel .monitoring-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
}

.monitoring-panel .interval-switch {
  display: inline-flex;
  padding: 3px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--surface-muted);
}

.monitoring-panel .interval-switch button {
  padding: 6px 10px;
  border: 0;
  border-radius: 7px;
  background: transparent;
  color: var(--text-secondary);
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
}

.monitoring-panel .interval-switch button.active {
  background: var(--primary);
  color: #ffffff;
}

.monitoring-panel .monitoring-refresh {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 14px;
  border: 1px solid var(--border-strong);
  border-radius: 10px;
  background: var(--surface-raised);
  color: var(--text);
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.monitoring-panel .monitoring-refresh:hover:not(:disabled) {
  border-color: var(--primary);
  color: var(--primary-text);
}

.monitoring-panel .monitoring-refresh:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.monitoring-panel .spinning {
  display: inline-block;
  animation: spinIcon 0.9s linear infinite;
}

@keyframes spinIcon {
  to { transform: rotate(360deg); }
}

.monitoring-panel .monitoring-placeholder {
  padding: 26px 16px;
  text-align: center;
  font-size: 13px;
  color: var(--text-secondary);
}

.monitoring-panel .monitoring-error {
  margin-bottom: 16px;
  padding: 12px 14px;
  border: 1px solid var(--danger-border);
  border-radius: 10px;
  background: var(--danger-bg);
  color: var(--danger-text);
  font-size: 12px;
}

.monitoring-panel .monitoring-system-info {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 18px;
}

.monitoring-panel .monitoring-system-info > div {
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface-muted);
  min-width: 0;
}

.monitoring-panel .monitoring-system-info span {
  display: block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--text-muted);
}

.monitoring-panel .monitoring-system-info strong {
  display: block;
  margin-top: 5px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-bright);
  word-break: break-word;
}

.monitoring-panel .resource-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.monitoring-panel .resource-card {
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface-raised);
  transition: border-color 0.2s ease, transform 0.2s ease;
}

.monitoring-panel .resource-card:hover {
  border-color: var(--primary);
  transform: translateY(-2px);
}

.monitoring-panel .resource-card.warning {
  border-color: rgba(245, 158, 11, 0.45);
}

.monitoring-panel .resource-card.critical {
  border-color: rgba(239, 68, 68, 0.55);
}

.monitoring-panel .resource-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 12px;
}

.monitoring-panel .resource-title span {
  display: block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
}

.monitoring-panel .tone-badge {
  display: inline-block;
  margin-top: 4px;
  padding: 2px 7px;
  border-radius: 6px;
  font-style: normal;
  font-size: 10px;
  font-weight: 700;
}

.monitoring-panel .tone-badge.healthy {
  background: var(--success-bg);
  color: var(--success-text);
}

.monitoring-panel .tone-badge.warning {
  background: rgba(245, 158, 11, 0.16);
  color: var(--warning-text);
}

.monitoring-panel .tone-badge.critical {
  background: var(--danger-bg);
  color: var(--danger-text);
}

.monitoring-panel .resource-title strong {
  font-size: 22px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: var(--text-bright);
  line-height: 1;
}

.monitoring-panel .resource-track {
  height: 8px;
  border-radius: 999px;
  background: var(--surface-muted);
  overflow: hidden;
  margin-bottom: 10px;
}

.monitoring-panel .resource-fill {
  height: 100%;
  border-radius: 999px;
  transition: width 0.45s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.25s ease;
}

.monitoring-panel .resource-fill.healthy {
  background: linear-gradient(90deg, #2563eb, #38bdf8);
}

.monitoring-panel .resource-fill.warning {
  background: linear-gradient(90deg, #d97706, #fbbf24);
}

.monitoring-panel .resource-fill.critical {
  background: linear-gradient(90deg, #dc2626, #f87171);
}

.monitoring-panel .resource-card small {
  display: block;
  font-size: 11px;
  font-variant-numeric: tabular-nums;
  color: var(--text-secondary);
}

.monitoring-panel .network-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin-top: 14px;
}

.monitoring-panel .network-card {
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: 14px;
  background: var(--surface-raised);
}

.monitoring-panel .net-head {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--text-secondary);
}

.monitoring-panel .net-icon {
  width: 22px;
  height: 22px;
  display: inline-grid;
  place-items: center;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 800;
}

.monitoring-panel .net-icon.rx {
  background: rgba(59, 130, 246, 0.16);
  color: var(--primary-text);
}

.monitoring-panel .net-icon.tx {
  background: rgba(16, 185, 129, 0.16);
  color: var(--success-text);
}

.monitoring-panel .network-card strong {
  display: block;
  margin: 10px 0 4px;
  font-size: 20px;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  color: var(--text-bright);
}

.monitoring-panel .network-card small {
  font-size: 11px;
  color: var(--text-muted);
}

.monitoring-panel .monitoring-footer {
  margin-top: 16px;
  padding-top: 14px;
  border-top: 1px solid var(--border-subtle);
  display: flex;
  justify-content: space-between;
  gap: 10px;
  flex-wrap: wrap;
  font-size: 11px;
  color: var(--text-muted);
}

@media (max-width: 1100px) {
  .monitoring-panel .resource-grid,
  .monitoring-panel .monitoring-system-info {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .monitoring-panel {
    padding: 16px;
    border-radius: 14px;
  }

  .monitoring-panel .monitoring-heading {
    flex-direction: column;
    align-items: stretch;
  }

  .monitoring-panel .monitoring-controls {
    justify-content: space-between;
  }

  .monitoring-panel .monitoring-system-info,
  .monitoring-panel .resource-grid,
  .monitoring-panel .network-grid {
    grid-template-columns: 1fr;
  }
}

/* === Modern & Responsive Storage Format Dialog === */
.fm-format-overlay {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(2, 6, 23, 0.72);
  backdrop-filter: blur(5px);
}

.fm-format-dialog {
  width: 100%;
  max-width: 580px;
  max-height: 92dvh;
  overflow-y: auto;
  padding: 24px;
  border: 1px solid var(--border-strong);
  border-radius: 16px;
  background: var(--surface);
  color: var(--text);
  box-shadow: 0 24px 60px rgba(2, 6, 23, 0.45);
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.fm-format-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 14px;
  border-bottom: 1px solid var(--border-subtle);
}

.fm-format-heading h2 {
  margin: 0;
  font-size: 18px;
  font-weight: 700;
  color: var(--text-bright);
}

.fm-format-heading p {
  margin: 5px 0 0;
  font-size: 12px;
  color: var(--text-secondary);
}

.fm-format-close {
  width: 34px;
  height: 34px;
  flex-shrink: 0;
  display: inline-grid;
  place-items: center;
  border: 1px solid var(--border-strong);
  border-radius: 10px;
  background: var(--surface-muted);
  color: var(--text-secondary);
  font-size: 18px;
  line-height: 1;
  cursor: pointer;
}

.fm-format-close:hover:not(:disabled) {
  border-color: var(--primary);
  color: var(--text-bright);
}

.fm-format-device {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  padding: 0 !important;
  border: 0 !important;
  background: transparent !important;
}

.fm-format-device > div {
  padding: 11px 13px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface-muted);
  min-width: 0;
}

.fm-format-device span {
  display: block;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.fm-format-device strong {
  display: block;
  margin-top: 4px;
  font-size: 13px;
  font-weight: 600;
  color: var(--text-bright);
  word-break: break-word;
}

.fm-format-notice,
.fm-format-error {
  padding: 12px 14px;
  border-radius: 12px;
  font-size: 12px;
  line-height: 1.55;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.fm-format-notice {
  border: 1px solid var(--border);
  background: var(--surface-raised);
  color: var(--text-secondary);
}

.fm-format-notice.is-safe {
  border-color: rgba(34, 197, 94, 0.35);
  background: var(--success-bg);
  color: var(--success-text);
}

.fm-format-notice.is-blocked,
.fm-format-error {
  border: 1px solid var(--danger-border);
  background: var(--danger-bg);
  color: var(--danger-text);
}

.fm-format-reasons {
  margin: 0;
  padding: 12px 14px 12px 28px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--surface-muted);
  color: var(--text-secondary);
  font-size: 12px;
  line-height: 1.6;
}

.fm-format-options {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}

.fm-format-options label {
  display: flex;
  flex-direction: column;
  gap: 6px;
  font-size: 12px;
  font-weight: 600;
  color: var(--text-soft);
}

.fm-format-options .fm-format-confirm-field,
.fm-format-options .fm-format-warning {
  grid-column: 1 / -1;
}

.fm-format-confirm-field code {
  margin-left: 4px;
  padding: 2px 6px;
  border-radius: 6px;
  background: var(--surface-muted);
  border: 1px solid var(--border);
  font-size: 11px;
  color: var(--primary-text);
}

.fm-format-options select,
.fm-format-options input {
  width: 100%;
  padding: 10px 12px;
  border: 1px solid var(--border-strong);
  border-radius: 10px;
  background: var(--surface-muted);
  color: var(--text-bright);
  font-size: 13px;
  outline: none;
}

.fm-format-options select:focus,
.fm-format-options input:focus {
  border-color: var(--primary);
  box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.16);
}

.fm-format-options input.is-match {
  border-color: #22c55e;
}

.fm-format-options input.is-mismatch {
  border-color: #ef4444;
}

.fm-format-warning {
  margin: 2px 0 0;
  padding: 12px 14px;
  border: 1px solid rgba(245, 158, 11, 0.4);
  border-left: 4px solid #f59e0b;
  border-radius: 10px;
  background: rgba(245, 158, 11, 0.1);
  color: var(--text-soft);
  font-size: 12px;
  line-height: 1.6;
}

.fm-format-warning strong {
  color: var(--warning-text);
}

.fm-format-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10px;
  padding-top: 14px;
  border-top: 1px solid var(--border-subtle);
  flex-wrap: wrap;
}

.fm-format-actions .fm-button {
  padding: 10px 15px;
  border-radius: 10px;
  font-size: 12px;
  font-weight: 600;
  cursor: pointer;
}

.fm-format-actions .fm-secondary {
  border: 1px solid var(--border-strong);
  background: var(--surface-raised);
  color: var(--text);
}

.fm-format-actions .fm-format-button {
  border: 1px solid #dc2626;
  background: #dc2626;
  color: #ffffff;
}

.fm-format-actions .fm-format-button:hover:not(:disabled) {
  background: #b91c1c;
}

.fm-format-actions .fm-button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

@media (max-width: 560px) {
  .fm-format-overlay {
    padding: 12px;
    align-items: flex-end;
  }

  .fm-format-dialog {
    padding: 18px 16px;
    border-radius: 16px 16px 12px 12px;
    max-height: 90dvh;
  }

  .fm-format-device,
  .fm-format-options {
    grid-template-columns: 1fr;
  }

  .fm-format-actions {
    flex-direction: column-reverse;
    align-items: stretch;
  }

  .fm-format-actions .fm-button {
    width: 100%;
    text-align: center;
  }
}

