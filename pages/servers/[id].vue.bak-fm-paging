}

:global(html[data-theme="light"]) .secondary-action,
:global(html[data-theme="light"]) .cancel-button,
:global(html[data-theme="light"]) .monitoring-refresh,
:global(html[data-theme="light"]) .history-refresh,
:global(html[data-theme="light"]) .fm-action,
:global(html[data-theme="light"]) .fm-secondary,
:global(html[data-theme="light"]) .fm-format-close {
  background: var(--text-bright) !important;
