.fm-toolbar { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:12px; margin-top:20px; padding:12px; border:1px solid var(--border); border-radius:8px; background:var(--surface-muted); }
.fm-breadcrumb { display:flex; align-items:center; flex-wrap:wrap; gap:8px; min-width:0; }
.fm-crumb { padding:3px 0; border:0; background:transparent; color:var(--primary-text); font-size:10px; cursor:pointer; }
.fm-crumb:disabled { color:var(--text); cursor:default; }
.fm-crumb-separator { color:var(--text-muted); font-size:10px; }
.fm-current-path { display:flex; align-items:center; flex-wrap:wrap; gap:10px; margin:12px 0; color:var(--text-muted); font-size:9px; }
.fm-current-path code { color:var(--text-soft); overflow-wrap:anywhere; }
.fm-table-wrap { width:100%; overflow-x:auto; border:1px solid var(--border); border-radius:8px; }
.fm-table { width:100%; border-collapse:collapse; min-width:760px; font-size:10px; text-align:left; }
.fm-table th { padding:12px; background:var(--surface-muted); color:var(--text-secondary); font-weight:700; white-space:nowrap; }
.fm-table td { padding:11px 12px; border-top:1px solid var(--border); color:var(--text-soft); white-space:nowrap; }
.fm-name-cell { display:flex; align-items:center; gap:9px; max-width:300px; }
.fm-file-icon { flex:none; }
.fm-name { overflow:hidden; text-overflow:ellipsis; }
.fm-table code { color:var(--text-secondary); }
.fm-action { padding:6px 9px; border:1px solid var(--border-strong); border-radius:5px; background:var(--surface-hover); color:var(--primary-soft-text); font-size:9px; cursor:pointer; }
.fm-disabled-action { color:var(--text-muted); font-size:9px; }
.fm-placeholder { padding:25px 10px; color:var(--text-secondary); text-align:center; font-size:10px; }
.fm-error,.fm-success { margin-top:12px; padding:11px; border-radius:7px; font-size:10px; line-height:1.6; overflow-wrap:anywhere; }
.fm-error { border:1px solid var(--danger-border); background:var(--danger-bg); color:var(--danger-text); }
.fm-success { border:1px solid #166534; background:var(--success-bg); color:var(--success-text); }
.fm-upload { margin-top:18px; padding:17px; border:1px solid var(--border); border-radius:8px; background:var(--surface-muted); }
.fm-upload h3,.fm-storage h3 { margin:0; font-size:12px; }
.fm-upload > div:first-child p,.fm-storage-heading p { color:var(--text-secondary); font-size:9px; line-height:1.6; }
.fm-upload-controls { display:flex; align-items:center; flex-wrap:wrap; gap:10px; margin-top:13px; }
.fm-file-input { max-width:100%; color:var(--text-soft); font-size:10px; }
.fm-file-selection { color:var(--primary-soft-text); font-size:9px; overflow-wrap:anywhere; }
.fm-storage { margin-top:22px; padding-top:19px; border-top:1px solid var(--border); }
.fm-storage-heading { margin-bottom:14px; }
.fm-device-name { display:inline-block; }
.fm-drive-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:13px; }
.fm-drive-card { min-width:0; padding:15px; border:1px solid var(--border-strong); border-radius:9px; background:var(--surface-muted); }
.fm-drive-card-heading { display:flex; align-items:center; gap:11px; min-width:0; }
.fm-drive-icon { display:grid; place-items:center; flex:none; width:42px; height:42px; border-radius:9px; background:var(--surface-hover); color:var(--primary-soft-text); font-size:25px; }
.fm-drive-title { display:flex; flex:1; flex-direction:column; gap:5px; min-width:0; }
.fm-drive-title strong { color:var(--text); font-size:12px; }
.fm-drive-title span { color:var(--text-secondary); font-size:9px; overflow-wrap:anywhere; }
.fm-drive-status { flex:none; padding:5px 7px; border-radius:5px; background:#422006; color:#fcd34d; font-size:8px; }
.fm-drive-status.is-mounted { background:var(--success-bg); color:var(--success-text); }
.fm-drive-details { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; margin-top:15px; padding:11px 0; border-top:1px solid var(--border); border-bottom:1px solid var(--border); }
.fm-drive-details div { display:flex; flex-direction:column; gap:5px; min-width:0; }
.fm-drive-details span { color:var(--text-muted); font-size:8px; }
.fm-drive-details strong { color:var(--text-soft); font-size:9px; overflow-wrap:anywhere; }
.fm-drive-volumes { margin-top:13px; }
.fm-drive-volumes h4 { margin:0 0 8px; color:var(--text-secondary); font-size:9px; }
.fm-volume-item { display:flex; align-items:center; gap:9px; padding:10px 0; border-top:1px solid var(--border-subtle); }
.fm-volume-icon { flex:none; color:var(--primary-text); font-size:20px; }
.fm-volume-info { display:flex; flex:1; flex-direction:column; gap:4px; min-width:0; }
.fm-volume-info strong { color:var(--text); font-size:10px; }
.fm-volume-info span { color:var(--text-secondary); font-size:8px; overflow-wrap:anywhere; }
.fm-volume-info .fm-volume-mount { color:var(--success-text); }
.fm-volume-info .fm-volume-unmounted { color:var(--warning-text); }
.fm-volume-item .fm-button,.fm-drive-footer .fm-button { flex:none; padding:7px 9px; }
.fm-drive-empty { padding:13px 0 2px; color:var(--warning-text); font-size:9px; }
.fm-drive-footer { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; margin-top:12px; padding-top:11px; border-top:1px solid var(--border); }
.fm-drive-footer span { color:var(--success-text); font-size:9px; overflow-wrap:anywhere; }
.fm-mount-list { margin-top:17px; }
.fm-mount-list h4 { margin:0 0 9px; color:var(--text-soft); font-size:10px; }
.fm-mount-item { display:flex; flex-wrap:wrap; justify-content:space-between; gap:8px; padding:9px 11px; border-top:1px solid var(--border); font-size:9px; }
.fm-mount-item strong { color:var(--text); overflow-wrap:anywhere; }
.fm-mount-item span { color:var(--text-secondary); overflow-wrap:anywhere; }
.fm-storage-footer { margin:12px 0 0; color:var(--text-muted); font-size:9px; }

.fm-drive-format-action { display:flex; flex-direction:column; align-items:flex-start; gap:7px; margin-top:12px; padding-top:11px; border-top:1px solid var(--border); }
.fm-drive-format-action > span { color:var(--text-secondary); font-size:9px; line-height:1.5; }
.fm-format-button { background:#92400e !important; border-color:#b45309 !important; color:#fff7ed !important; }
.fm-format-overlay { position:fixed; inset:0; z-index:10000; display:flex; align-items:center; justify-content:center; padding:18px; background:rgba(2,6,23,.82); backdrop-filter:blur(4px); }
.fm-format-dialog { width:min(100%,560px); max-height:calc(100vh - 36px); overflow-y:auto; padding:21px; border:1px solid var(--text-muted); border-radius:13px; background:var(--surface-deep); color:var(--text); box-shadow:0 24px 70px rgba(0,0,0,.55); }
.fm-format-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:14px; margin-bottom:17px; }
.fm-format-heading h2 { margin:0; color:var(--text-bright); font-size:17px; }
.fm-format-heading p { margin:5px 0 0; color:var(--text-secondary); font-size:11px; }
.fm-format-close { width:30px; height:30px; border:1px solid var(--text-muted); border-radius:7px; background:var(--border-subtle); color:var(--text); font-size:20px; cursor:pointer; }
.fm-format-device { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; padding:13px; border:1px solid var(--border-strong); border-radius:9px; background:#111c2e; }
.fm-format-device div { display:flex; flex-direction:column; gap:4px; min-width:0; }
.fm-format-device span { color:var(--text-secondary); font-size:10px; }
.fm-format-device strong { color:var(--text-bright); font-size:12px; overflow-wrap:anywhere; }
.fm-format-notice { display:flex; flex-direction:column; gap:5px; margin-top:13px; padding:12px; border:1px solid var(--text-muted); border-radius:8px; background:var(--border-subtle); font-size:11px; line-height:1.5; }
.fm-format-notice span { color:var(--text-soft); }
.fm-format-notice.is-safe { border-color:#166534; background:#052e16; }
.fm-format-notice.is-blocked, .fm-format-error { border-color:#991b1b; background:#450a0a; color:var(--danger-text); }
.fm-format-error { margin-top:12px; padding:11px; border:1px solid #991b1b; border-radius:8px; font-size:11px; overflow-wrap:anywhere; }
.fm-format-reasons { margin:10px 0 0; padding-left:20px; color:var(--danger-text); font-size:11px; line-height:1.7; }
.fm-format-options { display:flex; flex-direction:column; gap:13px; margin-top:17px; }
.fm-format-options label { display:flex; flex-direction:column; gap:7px; color:var(--text-soft); font-size:11px; }
.fm-format-options input, .fm-format-options select { width:100%; min-height:39px; padding:9px 11px; border:1px solid var(--text-muted); border-radius:7px; outline:none; background:#111c2e; color:var(--text-bright); font:inherit; }
.fm-format-options input:focus, .fm-format-options select:focus { border-color:var(--primary-text); }
.fm-format-warning { margin:0; padding:12px; border:1px solid #b45309; border-radius:8px; background:#451a03; color:#fed7aa; font-size:10px; line-height:1.65; }
.fm-format-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:9px; margin-top:19px; }
@media (max-width:480px) {
  .fm-format-overlay { padding:10px; }
  .fm-format-dialog { padding:15px; }
  .fm-format-device { grid-template-columns:1fr 1fr; }
  .fm-format-actions { justify-content:stretch; }
  .fm-format-actions button { flex:1; }
}

