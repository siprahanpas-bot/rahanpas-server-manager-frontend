                            <span class="aa-file-ico">{{ fmFileIcon(item) }}</span>
                            <span class="aa-entry-name">{{ item.name }}</span>
                          </button>
                          <button
                            v-else-if="isImageFile(item)"
                            type="button"
                            class="aa-entry-btn"
                            :disabled="!fileManagerCanModifyCurrentPath"
                            @click="openImagePreview(item)"
