:global(html[data-theme="light"]) .fm-table-wrap {
  border-color: var(--text) !important;
}

:global(html[data-theme="light"]) .fm-table th {
  background: #f1f5f9 !important;
  color: var(--text-muted) !important;
}

:global(html[data-theme="light"]) .fm-table td {
  background: #ffffff !important;
  color: var(--border-strong) !important;
  border-color: var(--text) !important;
}

:global(html[data-theme="light"]) .fm-table code,
:global(html[data-theme="light"]) .fm-current-path code {
  color: var(--text-muted) !important;
}

:global(html[data-theme="light"]) .fm-format-notice {
  background: #f1f5f9 !important;
  color: var(--border-strong) !important;
  border-color: var(--text-soft) !important;
}

:global(html[data-theme="light"]) .fm-format-warning {
