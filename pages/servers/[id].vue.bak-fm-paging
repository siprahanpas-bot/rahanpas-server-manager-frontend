        <Teleport to="body">
          <div
            v-if="imagePreviewOpen"
            class="aa-lightbox-overlay"
            @click.self="closeImagePreview"
          >
            <section
              class="aa-lightbox"
              role="dialog"
              aria-modal="true"
              aria-label="Image Preview"
            >
              <header class="aa-lightbox-header">
                <div class="aa-lightbox-meta">
                  <strong>{{ imagePreviewItem?.name }}</strong>
                  <small>
                    {{ imagePreviewItem?.size != null ? formatBytes(imagePreviewItem.size) : '' }}
                    <template v-if="previewableImages.length > 1 && currentPreviewIndex !== -1">
                      · {{ currentPreviewIndex + 1 }} / {{ previewableImages.length }}
                    </template>
                  </small>
                </div>

                <div class="aa-lightbox-tools">
                  <button
                    type="button"
                    title="Zoom Out"
                    :disabled="imagePreviewZoom <= 0.5"
                    @click="imagePreviewZoom = Math.max(0.5, Number((imagePreviewZoom - 0.25).toFixed(2)))"
                  >
                    −
                  </button>
                  <button
                    type="button"
                    title="Reset Zoom"
                    @click="imagePreviewZoom = 1"
                  >
                    {{ Math.round(imagePreviewZoom * 100) }}%
                  </button>
                  <button
                    type="button"
                    title="Zoom In"
                    :disabled="imagePreviewZoom >= 3"
                    @click="imagePreviewZoom = Math.min(3, Number((imagePreviewZoom + 0.25).toFixed(2)))"
                  >
                    +
                  </button>
                  <button
                    v-if="imagePreviewItem"
                    type="button"
                    class="aa-lb-dl"
                    @click="downloadRemoteFile(imagePreviewItem)"
                  >
                    ↓ Download
                  </button>
                  <button
                    type="button"
                    class="aa-lb-close"
                    aria-label="Tutup preview"
                    @click="closeImagePreview"
                  >
                    ×
                  </button>
                </div>
              </header>

              <div class="aa-lightbox-stage">
                <button
                  v-if="previewableImages.length > 1"
                  type="button"
                  class="aa-lb-nav prev"
                  aria-label="Gambar sebelumnya"
                  @click="stepImagePreview(-1)"
                >
                  ‹
                </button>

                <div v-if="imagePreviewLoading" class="aa-lb-state">
                  Memuat gambar...
                </div>
                <div v-else-if="imagePreviewError" class="aa-lb-state is-error">
                  {{ imagePreviewError }}
                </div>
                <div v-else-if="imagePreviewUrl" class="aa-lb-canvas">
                  <img
                    :src="imagePreviewUrl"
                    :alt="imagePreviewItem?.name || 'Preview'"
                    :style="{ transform: `scale(${imagePreviewZoom})` }"
                  >
                </div>

                <button
                  v-if="previewableImages.length > 1"
                  type="button"
                  class="aa-lb-nav next"
                  aria-label="Gambar berikutnya"
                  @click="stepImagePreview(1)"
                >
                  ›
                </button>
              </div>
            </section>
          </div>
        </Teleport>

