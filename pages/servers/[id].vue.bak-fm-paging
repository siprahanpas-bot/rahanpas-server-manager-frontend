<script setup lang="ts">
interface ManagedServer {
  id: number
  name: string
  hostname: string | null
  ip_address: string | null
  os_type: 'linux' | 'windows'
  connection_protocol: string
  port: number
  username: string
  auth_method: 'password' | 'private_key'
  verify_host_key: boolean
  host_key_fingerprint: string | null
  status: string
  last_checked_at: string | null
  last_error: string | null
  notes: string | null
  created_at: string
  updated_at: string
}

const route = useRoute()
const serverId = String(route.params.id)

const server = ref<ManagedServer | null>(null)
const loading = ref(true)
const saving = ref(false)
const deleting = ref(false)
const editing = ref(false)
const errorMessage = ref('')
const fieldErrors = ref<Record<string, string[]>>({})

const discoveringHostKey = ref(false)
const testingConnection = ref(false)
const connectionMessage = ref('')
const connectionError = ref('')
const hostKeyCandidate = ref<{
  key_type: string
  fingerprint: string
} | null>(null)
const fingerprintTrusted = ref(false)


const form = reactive({
  name: '',
  hostname: '',
  ip_address: '',
  os_type: 'linux',
  connection_protocol: 'ssh',
  port: 22,
  username: '',
  auth_method: 'password',
  password: '',
  private_key: '',
  private_key_passphrase: '',
  verify_host_key: true,
  host_key_fingerprint: '',
  notes: ''
})

const protocolLabel = computed(() => {
  const labels: Record<string, string> = {
    ssh: 'SSH',
    winrm: 'WinRM',
    windows_openssh: 'Windows OpenSSH'
  }
  return labels[server.value?.connection_protocol || ''] || '-'
})

const authLabel = computed(() =>
  server.value?.auth_method === 'private_key'
    ? 'SSH Private Key'
    : 'Username & Password'
)

function statusClass(status: string) {
  return {
    online: 'status-online',
    offline: 'status-offline',
    error: 'status-error',
    unknown: 'status-unknown'
  }[status] || 'status-unknown'
}

function formatDate(value: string | null) {
  if (!value) return 'Belum diperiksa'

  return new Date(value).toLocaleString('id-ID', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Asia/Jakarta'
  })
}

function populateForm(data: ManagedServer) {
  form.name = data.name
  form.hostname = data.hostname || ''
  form.ip_address = data.ip_address || ''
  form.os_type = data.os_type
  form.connection_protocol = data.connection_protocol
  form.port = data.port
  form.username = data.username
  form.auth_method = data.auth_method
  form.password = ''
  form.private_key = ''
  form.private_key_passphrase = ''
  form.verify_host_key = data.verify_host_key
  form.host_key_fingerprint = data.host_key_fingerprint || ''
  form.notes = data.notes || ''
}

async function loadServer() {
  loading.value = true
  errorMessage.value = ''

  try {
    const result: any = await $fetch(`/manager-api/servers/${serverId}`)
    server.value = result.server
    populateForm(result.server)
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    errorMessage.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal mengambil informasi server.'
  } finally {
    loading.value = false
  }
}

function cancelEdit() {
  if (server.value) populateForm(server.value)
  editing.value = false
  errorMessage.value = ''
  fieldErrors.value = {}
}

watch(() => form.os_type, (os) => {
  if (os === 'linux') {
    form.connection_protocol = 'ssh'
    form.port = 22
  } else {
    form.connection_protocol = 'winrm'
    form.port = 5985
  }
})

watch(() => form.connection_protocol, (protocol) => {
  form.port = protocol === 'winrm' ? 5985 : 22

  if (protocol === 'winrm' && form.auth_method === 'private_key') {
    form.auth_method = 'password'
  }
})

watch(() => form.auth_method, () => {
  form.password = ''
  form.private_key = ''
  form.private_key_passphrase = ''
})

async function saveChanges() {
  saving.value = true
  errorMessage.value = ''
  fieldErrors.value = {}

  const payload: Record<string, any> = {
    name: form.name,
    hostname: form.hostname || null,
    ip_address: form.ip_address || null,
    os_type: form.os_type,
    connection_protocol: form.connection_protocol,
    port: form.port,
    username: form.username,
    auth_method: form.auth_method,
    verify_host_key: form.verify_host_key,
    host_key_fingerprint: form.host_key_fingerprint || null,
    notes: form.notes || null
  }

  // Jangan kirim credential lama atau field credential kosong.
  // Credential hanya dikirim jika pengguna memasukkan yang baru.
  if (form.auth_method === 'password' && form.password) {
    payload.password = form.password
  }

  if (form.auth_method === 'private_key') {
    if (form.private_key) {
      payload.private_key = form.private_key
      payload.private_key_passphrase =
        form.private_key_passphrase || null
    }
  }

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}`,
      {
        method: 'PUT',
        body: payload
      }
    )

    server.value = result.server
    populateForm(result.server)
    editing.value = false
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    errorMessage.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal memperbarui konfigurasi server.'

    fieldErrors.value =
      error.data?.data?.errors ||
      error.data?.errors ||
      {}
  } finally {
    saving.value = false
  }
}


async function discoverHostKey() {
  if (!server.value) return

  discoveringHostKey.value = true
  connectionError.value = ''
  connectionMessage.value = ''
  hostKeyCandidate.value = null
  fingerprintTrusted.value = false

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/discover-host-key`,
      { method: 'POST' }
    )

    hostKeyCandidate.value = result.host_key
    connectionMessage.value =
      result.warning ||
      'Bandingkan fingerprint dengan server melalui jalur tepercaya.'
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    connectionError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal mengambil SSH host key.'
  } finally {
    discoveringHostKey.value = false
  }
}

function useDiscoveredFingerprint() {
  if (!hostKeyCandidate.value || !fingerprintTrusted.value) return

  form.host_key_fingerprint = hostKeyCandidate.value.fingerprint
  form.verify_host_key = true

  hostKeyCandidate.value = null
  fingerprintTrusted.value = false
  connectionMessage.value =
    'Fingerprint dimasukkan ke form. Klik Save Changes untuk menyimpannya.'
  editing.value = true
}

async function testConnection() {
  if (!server.value || testingConnection.value) return

  if (
    !['ssh', 'windows_openssh'].includes(
      server.value.connection_protocol
    )
  ) {
    connectionError.value =
      'Pengujian koneksi untuk protokol ini belum tersedia.'
    return
  }

  if (
    server.value.verify_host_key &&
    !server.value.host_key_fingerprint
  ) {
    connectionError.value =
      'Fingerprint host key belum tersimpan. Lakukan discovery, verifikasi, dan simpan fingerprint terlebih dahulu.'
    return
  }

  testingConnection.value = true
  connectionError.value = ''
  connectionMessage.value = ''

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/test-connection`,
      { method: 'POST' }
    )

    if (result.server) {
      server.value = result.server
      populateForm(result.server)
    }

    connectionMessage.value =
      result.message || 'Koneksi SSH berhasil.'
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    connectionError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Pengujian koneksi gagal.'

    // Ambil status terbaru yang mungkin sudah diperbarui backend.
    await loadServer()
  } finally {
    testingConnection.value = false
  }
}

async function deleteServer() {
  if (!server.value) return

  const confirmed = confirm(
    `Apakah Anda yakin ingin menghapus server "${server.value.name}"?\n\nTindakan ini tidak dapat dibatalkan.`
  )

  if (!confirmed) return

  deleting.value = true
  errorMessage.value = ''

  try {
    await $fetch(`/manager-api/servers/${serverId}`, {
      method: 'DELETE'
    })

    await navigateTo('/servers')
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    errorMessage.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal menghapus server.'
  } finally {
    deleting.value = false
  }
}


const metrics = ref<any>(null)
const monitoringLoading = ref(false)
const monitoringError = ref('')
const monitoringMessage = ref('')

const monitoringSupported = computed(() =>
  server.value?.os_type === 'linux' &&
  server.value?.connection_protocol === 'ssh'
)

async function loadMonitoring() {
  if (!server.value || !monitoringSupported.value || monitoringLoading.value) {
    return
  }

  monitoringLoading.value = true
  monitoringError.value = ''
  monitoringMessage.value = ''

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/monitoring`
    )

    metrics.value = result.metrics

    server.value.status = result.server_status?.status || 'online'
    server.value.last_checked_at =
      result.server_status?.last_checked_at || new Date().toISOString()
    server.value.last_error = null

    monitoringMessage.value = result.message || 'Monitoring berhasil diperbarui.'
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    monitoringError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal mengambil data monitoring.'

    if (server.value) {
      server.value.status = 'error'
      server.value.last_error = monitoringError.value
      server.value.last_checked_at = new Date().toISOString()
    }
  } finally {
    monitoringLoading.value = false
  }
}

function formatBytes(value: number) {
  if (!Number.isFinite(value) || value < 0) return '-'

  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  let size = value
  let index = 0

  while (size >= 1024 && index < units.length - 1) {
    size /= 1024
    index++
  }

  return `${size.toFixed(2)} ${units[index]}`
}

function formatUptime(value: number) {
  if (!Number.isFinite(value) || value < 0) return '-'

  const days = Math.floor(value / 86400)
  const hours = Math.floor((value % 86400) / 3600)
  const minutes = Math.floor((value % 3600) / 60)

  return `${days} hari ${hours} jam ${minutes} menit`
}


type HistoryPeriod = '1h' | '6h' | '24h' | '7d'

const historyPeriod = ref<HistoryPeriod>('1h')
const historyPoints = ref<any[]>([])
const historyLoading = ref(false)
const historyError = ref('')

const historyPeriods: { label: string; value: HistoryPeriod }[] = [
  { label: '1 Jam', value: '1h' },
  { label: '6 Jam', value: '6h' },
  { label: '24 Jam', value: '24h' },
  { label: '7 Hari', value: '7d' },
]

const historyCharts = [
  { key: 'cpu_usage_percent', title: 'CPU Usage', description: 'Penggunaan processor' },
  { key: 'memory_usage_percent', title: 'RAM Usage', description: 'Penggunaan memori' },
  { key: 'disk_usage_percent', title: 'Disk Usage', description: 'Penggunaan root disk' },
]

const historyNetworkCharts = [
  { key: 'network_rx_bytes', title: 'Network Download', description: 'Incoming traffic (RX)' },
  { key: 'network_tx_bytes', title: 'Network Upload', description: 'Outgoing traffic (TX)' },
]

async function loadHistory() {
  if (!server.value || !monitoringSupported.value || historyLoading.value) {
    return
  }

  historyLoading.value = true
  historyError.value = ''

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/monitoring/history?period=${historyPeriod.value}`
    )

    historyPoints.value = Array.isArray(result.history)
      ? result.history
      : []
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    historyError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal mengambil histori monitoring.'
  } finally {
    historyLoading.value = false
  }
}

function historyX(index: number) {
  if (historyPoints.value.length <= 1) return 300

  return 24 + (index / (historyPoints.value.length - 1)) * 552
}

function historyY(value: number) {
  const normalized = Math.max(0, Math.min(100, Number(value) || 0))
  return 160 - (normalized / 100) * 140
}

function historyPolyline(metric: string) {
  return historyPoints.value
    .map((point, index) => {
      const x = historyX(index)
      const y = historyY(Number(point[metric]))
      return `${x},${y}`
    })
    .join(' ')
}

function historyNetworkRate(index: number, metric: string): number {
  if (index <= 0) return 0

  const current = historyPoints.value[index]
  const previous = historyPoints.value[index - 1]

  const currentBytes = Number(current[metric])
  const previousBytes = Number(previous[metric])

  const elapsedSeconds =
    (new Date(current.collected_at).getTime() -
      new Date(previous.collected_at).getTime()) / 1000

  if (
    !Number.isFinite(currentBytes) ||
    !Number.isFinite(previousBytes) ||
    elapsedSeconds <= 0 ||
    currentBytes < previousBytes
  ) {
    return 0
  }

  return ((currentBytes - previousBytes) * 8) / elapsedSeconds / 1000000
}

const historyNetworkScale = computed<number>(() => {
  let maximum = 0

  for (const chart of historyNetworkCharts) {
    historyPoints.value.forEach((_, index) => {
      maximum = Math.max(
        maximum,
        historyNetworkRate(index, chart.key)
      )
    })
  }

  return Math.max(1, Math.ceil(maximum / 5) * 5)
})

function historyNetworkMax(): number {
  return historyNetworkScale.value
}

function historyNetworkY(value: number): number {
  return 160 - (value / historyNetworkScale.value) * 140
}

function historyNetworkPolyline(metric: string): string {
  return historyPoints.value
    .map((_, index) => {
      return `${historyX(index)},${historyNetworkY(historyNetworkRate(index, metric))}`
    })
    .join(' ')
}

function formatHistoryTime(value: string) {
  if (!value) return '-'

  return new Date(value).toLocaleString('id-ID', {
    day: '2-digit',
    month: 'short',
    hour: '2-digit',
    minute: '2-digit',
    timeZone: 'Asia/Jakarta'
  })
}


// FILE_MANAGER_SCRIPT_START
interface RemoteFileItem {
  name: string
  path: string
  type: 'directory' | 'file' | 'symlink' | 'special'
  size: number | null
  modified_at: number | null
  permissions: string | null
  is_symlink: boolean
}

const fileManagerSupported = computed(() =>
  server.value?.os_type === 'linux' &&
  ['ssh', 'windows_openssh'].includes(server.value?.connection_protocol || '')
)

const fileManagerData = ref<any>(null)
const fileManagerLoading = ref(false)
const fileManagerError = ref('')
const fileManagerUploading = ref(false)
const fileManagerUploadError = ref('')
const fileManagerUploadMessage = ref('')
const selectedUploadFile = ref<File | null>(null)
const fileManagerActionLoading = ref(false)
const fileManagerActionError = ref('')
const fileManagerActionMessage = ref('')


const storageDevices = ref<any[]>([])
const storageMounts = ref<any[]>([])
const storageExplorableMountpoints = ref<string[]>([])
const storageDetectedAt = ref('')
const storageLoading = ref(false)
const storageError = ref('')
const storageActionDevice = ref('')
const storageActionError = ref('')

// Initialize & Format dialog state
const formatDialogOpen = ref(false)
const formatTargetDevice = ref<any>(null)
const formatPreflight = ref<any>(null)
const formatFilesystem = ref('ext4')
const formatLabel = ref('')
const formatTypedConfirmation = ref('')
const formatPreflightLoading = ref(false)
const formatPreflightError = ref('')
const formatExecuting = ref(false)
const formatError = ref('')
const formatSuccess = ref('')
const formatCompleted = ref(false)

const fileManagerItems = computed<RemoteFileItem[]>(() =>
  Array.isArray(fileManagerData.value?.items)
    ? fileManagerData.value.items
    : []
)

const fileManagerCanModifyCurrentPath = computed(() => {
  const root = String(fileManagerData.value?.root_path || '')
    .replace(/\/+$/, '') || '/'
  const current = String(fileManagerData.value?.current_path || '')

  if (!current.startsWith('/') || !root.startsWith('/')) return false
  if (fileManagerData.value?.read_only === true) return false

  return root === '/'
    ? current.startsWith('/')
    : current === root || current.startsWith(root + '/')
})

const fileManagerBreadcrumbs = computed(() => {
  const root = String(fileManagerData.value?.root_path || '')
  const current = String(fileManagerData.value?.current_path || '')

  if (!root || !current) return []

  const relative = current === root
    ? ''
    : current.startsWith(root.replace(/\/+$/, '') + '/')
      ? current.slice(root.replace(/\/+$/, '').length + 1)
      : ''

  const segments = relative.split('/').filter(Boolean)
  const homeRoot = String(fileManagerData.value?.home_root_path || root)
  const result = [{
    label: root === homeRoot ? 'Home' : 'Storage',
    path: root
  }]
  let accumulated = root.replace(/\/+$/, '')

  for (const segment of segments) {
    accumulated += '/' + segment
    result.push({ label: segment, path: accumulated })
  }

  return result
})

const flattenedStorageDevices = computed(() => {
  const result: any[] = []

  function visit(devices: any[], depth = 0) {
    for (const device of devices) {
      result.push({ ...device, depth })

      if (Array.isArray(device.children) && device.children.length) {
        visit(device.children, depth + 1)
      }
    }
  }

  visit(storageDevices.value)
  return result
})

const storageDriveDevices = computed(() =>
  storageDevices.value.filter((device: any) => device.type === 'disk')
)

function storageDeviceMountpoint(device: any) {
  if (device.mountpoint) return device.mountpoint

  if (Array.isArray(device.children)) {
    const mounted = device.children.find((child: any) => child.mountpoint)
    if (mounted) return mounted.mountpoint
  }

  return ''
}

function storageDeviceStatus(device: any) {
  if (storageDeviceMountpoint(device)) return 'Mounted'
  if (Array.isArray(device.children) && device.children.length) {
    return 'Partitions detected'
  }
  if (!device.fstype && !device.mountpoint) return 'Unknown / Uninitialized'
  return 'Not mounted'
}

function storageCanExplore(mountpoint: string) {
  const target = String(mountpoint || '')

  if (
    !target.startsWith('/') ||
    target.split('/').includes('..')
  ) {
    return false
  }

  if (target === '/') {
    return storageExplorableMountpoints.value.includes('/')
  }

  const home = String(
    fileManagerData.value?.home_root_path ||
    fileManagerData.value?.root_path ||
    ''
  ).replace(/\/+$/, '') || '/'

  if (home !== '/' && (target === home || target.startsWith(home + '/'))) {
    return true
  }

  return storageExplorableMountpoints.value.includes(target)
}

function openStorageMount(mountpoint: string) {
  if (!storageCanExplore(mountpoint)) return
  void loadRemoteFiles(mountpoint)
}

async function loadRemoteFiles(path?: string) {
  if (!fileManagerSupported.value || fileManagerLoading.value) return

  fileManagerLoading.value = true
  fileManagerError.value = ''

  try {
    const targetPath = path ?? fileManagerData.value?.current_path
    const query = targetPath
      ? `?path=${encodeURIComponent(targetPath)}`
      : ''

    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/files${query}`
    )

    fileManagerData.value = result.data || null
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    fileManagerError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      error.statusMessage ||
      'Gagal membaca direktori server.'
  } finally {
    fileManagerLoading.value = false
  }
}

async function loadStorageDevices() {
  if (!fileManagerSupported.value || storageLoading.value) return

  storageLoading.value = true
  storageError.value = ''

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/storage-devices`
    )

    storageDevices.value = Array.isArray(result.data?.devices)
      ? result.data.devices
      : []

    storageMounts.value = Array.isArray(result.data?.mounts)
      ? result.data.mounts
      : []

    storageExplorableMountpoints.value = Array.isArray(
      result.data?.explorable_mountpoints
    )
      ? result.data.explorable_mountpoints
      : []

    storageDetectedAt.value = result.data?.detected_at || ''
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    storageError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      error.statusMessage ||
      'Gagal membaca informasi storage server.'
  } finally {
    storageLoading.value = false
  }
}

function storageCanMount(volume: any) {
  const isPartOrWholeDisk =
    volume?.type === 'part' ||
    (volume?.type === 'disk' && (!Array.isArray(volume?.children) || volume.children.length === 0))
  return (
    isPartOrWholeDisk &&
    /^\/dev\/[A-Za-z0-9._-]+$/.test(String(volume?.path || '')) &&
    ['ext2', 'ext3', 'ext4', 'xfs', 'btrfs', 'vfat', 'exfat', 'ntfs'].includes(
      String(volume?.fstype || '').toLowerCase()
    ) &&
    Boolean(volume?.uuid) &&
    !volume?.ro &&
    !volume?.mountpoint
  )
}

function storageCanUnmount(volume: any) {
  const isPartOrWholeDisk = volume?.type === 'part' || volume?.type === 'disk'
  return (
    isPartOrWholeDisk &&
    /^\/dev\/[A-Za-z0-9._-]+$/.test(String(volume?.path || '')) &&
    String(volume?.mountpoint || '').startsWith('/mnt/rahanpas-storage/')
  )
}

async function runStorageAction(volume: any, action: 'mount' | 'unmount') {
  if (storageActionDevice.value) return

  const devicePath = String(volume?.path || '')
  if (!devicePath) return

  const confirmed = window.confirm(
    action === 'mount'
      ? `Mount partisi ${devicePath} (${volume.fstype || 'unknown'})?`
      : `Unmount ${devicePath} dari ${volume.mountpoint}?`
  )

  if (!confirmed) return

  storageActionDevice.value = devicePath
  storageActionError.value = ''

  try {
    await $fetch(
      `/manager-api/servers/${serverId}/storage-devices/${action}`,
      {
        method: 'POST',
        body: { device_path: devicePath }
      }
    )

    if (action === 'unmount') {
      const mountpoint = String(volume?.mountpoint || '').replace(/\/+$/, '')
      const explorerPath = String(fileManagerData.value?.current_path || '')

      const explorerUsesUnmountedVolume = Boolean(
        mountpoint &&
        (
          explorerPath === mountpoint ||
          explorerPath.startsWith(`${mountpoint}/`)
        )
      )

      if (explorerUsesUnmountedVolume) {
        fileManagerData.value = null
        fileManagerError.value = ''
        selectedUploadFile.value = null
        fileManagerUploadError.value = ''
        fileManagerUploadMessage.value = ''
      }
    }

    await loadStorageDevices()

    if (action === 'mount') {
      const updated = storageDevices.value
        .flatMap((disk: any) => disk.children || [])
        .find((item: any) => item.path === devicePath)

      if (updated?.mountpoint && storageCanExplore(updated.mountpoint)) {
        await loadRemoteFiles(updated.mountpoint)
      }
    }
  } catch (error: any) {
    storageActionError.value =
      error.data?.message ||
      error.data?.statusMessage ||
      error.statusMessage ||
      `Gagal ${action} partisi.`
  } finally {
    storageActionDevice.value = ''
  }
}

function storageCanInitialize(device: any) {
  const path = String(device?.path || '')

  return (
    device?.type === 'disk' &&
    /^\/dev\/[A-Za-z0-9._-]+$/.test(path) &&
    !device?.ro &&
    !device?.mountpoint &&
    (!Array.isArray(device?.children) || device.children.length === 0)
  )
}

async function openStorageFormatDialog(device: any) {
  if (
    !storageCanInitialize(device) ||
    formatPreflightLoading.value ||
    formatExecuting.value
  ) return

  formatTargetDevice.value = device
  formatPreflight.value = null
  formatFilesystem.value = 'ext4'
  formatLabel.value = ''
  formatTypedConfirmation.value = ''
  formatPreflightError.value = ''
  formatError.value = ''
  formatSuccess.value = ''
  formatCompleted.value = false
  formatDialogOpen.value = true

  await inspectStorageFormat()
}

function closeStorageFormatDialog() {
  if (formatPreflightLoading.value || formatExecuting.value) return

  formatDialogOpen.value = false
  formatTargetDevice.value = null
  formatPreflight.value = null
  formatPreflightError.value = ''
  formatTypedConfirmation.value = ''
}

async function inspectStorageFormat() {
  if (
    formatPreflightLoading.value ||
    formatExecuting.value ||
    formatCompleted.value
  ) return

  const devicePath = String(formatTargetDevice.value?.path || '')

  if (!/^\/dev\/[A-Za-z0-9._-]+$/.test(devicePath)) {
    formatPreflightError.value = 'Path perangkat tidak valid.'
    return
  }

  formatPreflightLoading.value = true
  formatPreflightError.value = ''
  formatPreflight.value = null

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/storage-devices/inspect-format`,
      {
        method: 'POST',
        body: {
          device_path: devicePath
        }
      }
    )

    formatPreflight.value = result.data || null
    formatError.value = ''
    formatSuccess.value = ''
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    formatPreflightError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      error.statusMessage ||
      'Gagal memeriksa kelayakan perangkat.'
  } finally {
    formatPreflightLoading.value = false
  }
}

async function executeStorageFormat() {
  if (formatExecuting.value || formatCompleted.value) return

  const devicePath = String(formatTargetDevice.value?.path || '')
  const fingerprint = String(formatPreflight.value?.fingerprint || '')
  const supportedFilesystems = Array.isArray(
    formatPreflight.value?.supported_filesystems
  )
    ? formatPreflight.value.supported_filesystems
    : []

  if (
    !formatPreflight.value?.eligible ||
    !/^\/dev\/[A-Za-z0-9._-]+$/.test(devicePath) ||
    !/^[a-f0-9]{64}$/.test(fingerprint) ||
    !supportedFilesystems.includes(formatFilesystem.value) ||
    !/^[A-Za-z0-9._-]{0,12}$/.test(formatLabel.value) ||
    formatTypedConfirmation.value !== devicePath
  ) {
    formatError.value =
      'Validasi gagal. Periksa kelayakan disk, filesystem, label, fingerprint, dan konfirmasi path.'
    return
  }

  formatExecuting.value = true
  formatError.value = ''
  formatSuccess.value = ''

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/storage-devices/format`,
      {
        method: 'POST',
        body: {
          device_path: devicePath,
          fingerprint,
          filesystem: formatFilesystem.value,
          label: formatLabel.value,
          confirmation: formatTypedConfirmation.value
        }
      }
    )

    formatCompleted.value = true
    formatPreflight.value = null
    formatSuccess.value =
      result.data?.status === 'completed'
        ? 'Format berhasil diselesaikan dan filesystem telah diverifikasi.'
        : 'Request format berhasil diproses.'

    formatTypedConfirmation.value = ''

    await loadStorageDevices()
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    formatPreflight.value = null
    formatError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      error.statusMessage ||
      'Format gagal. Jangan mengulangi proses sebelum memeriksa kondisi disk dan menjalankan preflight ulang.'
  } finally {
    formatExecuting.value = false
  }
}

async function createRemoteFolder() {
  if (!fileManagerCanModifyCurrentPath.value || fileManagerActionLoading.value) return

  const name = window.prompt('Nama folder baru:')
  if (name === null) return

  const cleanName = name.trim()
  if (!cleanName) {
    fileManagerActionError.value = 'Nama folder tidak boleh kosong.'
    return
  }

  fileManagerActionLoading.value = true
  fileManagerActionError.value = ''
  fileManagerActionMessage.value = ''

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/files/directories`,
      {
        method: 'POST',
        body: {
          path: fileManagerData.value.current_path,
          name: cleanName
        }
      }
    )

    fileManagerActionMessage.value = result.message || 'Folder berhasil dibuat.'
    await loadRemoteFiles(fileManagerData.value.current_path)
  } catch (error: any) {
    fileManagerActionError.value =
      error.data?.message || error.statusMessage || 'Gagal membuat folder.'
  } finally {
    fileManagerActionLoading.value = false
  }
}

async function renameRemoteEntry(item: RemoteFileItem) {
  if (
    !fileManagerCanModifyCurrentPath.value ||
    fileManagerActionLoading.value ||
    item.is_symlink ||
    item.type === 'special'
  ) return

  const name = window.prompt('Masukkan nama baru:', item.name)
  if (name === null || name.trim() === item.name) return

  const newName = name.trim()
  if (!newName) {
    fileManagerActionError.value = 'Nama baru tidak boleh kosong.'
    return
  }

  fileManagerActionLoading.value = true
  fileManagerActionError.value = ''
  fileManagerActionMessage.value = ''

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/files/rename`,
      {
        method: 'PATCH',
        body: {
          path: item.path,
          name: newName
        }
      }
    )

    fileManagerActionMessage.value = result.message || 'Nama item berhasil diubah.'
    await loadRemoteFiles(fileManagerData.value.current_path)
  } catch (error: any) {
    fileManagerActionError.value =
      error.data?.message || error.statusMessage || 'Gagal mengubah nama item.'
  } finally {
    fileManagerActionLoading.value = false
  }
}

async function deleteRemoteEntry(item: RemoteFileItem) {
  if (
    !fileManagerCanModifyCurrentPath.value ||
    fileManagerActionLoading.value ||
    item.type === 'special'
  ) return

  if (item.type === 'directory' && !item.is_symlink) {
    if (!window.confirm(
      `Folder "${item.name}" beserta seluruh isi dan subfoldernya akan dihapus. Lanjutkan?`
    )) return

    const confirmation = window.prompt(
      `Ketik nama folder "${item.name}" untuk mengonfirmasi penghapusan:`
    )

    if (confirmation !== item.name) {
      fileManagerActionError.value = 'Konfirmasi nama folder tidak cocok. Penghapusan dibatalkan.'
      return
    }
  } else if (!window.confirm(`Hapus "${item.name}"?`)) {
    return
  }

  fileManagerActionLoading.value = true
  fileManagerActionError.value = ''
  fileManagerActionMessage.value = ''

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/files/delete`,
      {
        method: 'DELETE',
        body: { path: item.path }
      }
    )

    fileManagerActionMessage.value = result.message || 'Item berhasil dihapus.'
    await loadRemoteFiles(fileManagerData.value.current_path)
  } catch (error: any) {
    fileManagerActionError.value =
      error.data?.message || error.statusMessage || 'Gagal menghapus item.'
  } finally {
    fileManagerActionLoading.value = false
  }
}

function openRemoteDirectory(item: RemoteFileItem) {
  if (item.type !== 'directory' || item.is_symlink) return
  void loadRemoteFiles(item.path)
}

function handleUploadSelection(event: Event) {
  const input = event.target as HTMLInputElement
  selectedUploadFile.value = input.files?.[0] || null
  fileManagerUploadError.value = ''
  fileManagerUploadMessage.value = ''
}

async function uploadRemoteFile() {
  if (!selectedUploadFile.value || fileManagerUploading.value) return

  if (!fileManagerCanModifyCurrentPath.value) {
    fileManagerUploadError.value =
      'Lokasi upload tidak valid atau tidak diizinkan.'
    return
  }

  if (selectedUploadFile.value.size > 100 * 1024 * 1024) {
    fileManagerUploadError.value = 'Ukuran file melebihi batas 100 MB.'
    return
  }

  fileManagerUploading.value = true
  fileManagerUploadError.value = ''
  fileManagerUploadMessage.value = ''

  try {
    const formData = new FormData()
    formData.append('file', selectedUploadFile.value)

    if (fileManagerData.value?.current_path) {
      formData.append('path', fileManagerData.value.current_path)
    }

    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/files/upload`,
      {
        method: 'POST',
        body: formData
      }
    )

    fileManagerUploadMessage.value =
      result.message || 'File berhasil diunggah.'

    selectedUploadFile.value = null

    const input = document.getElementById(
      'file-manager-upload-input'
    ) as HTMLInputElement | null

    if (input) input.value = ''

    await loadRemoteFiles(fileManagerData.value?.current_path)
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    fileManagerUploadError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      error.statusMessage ||
      'Upload file gagal.'
  } finally {
    fileManagerUploading.value = false
  }
}

function downloadRemoteFile(item: RemoteFileItem) {
  if (!fileManagerCanModifyCurrentPath.value) return
  if (item.type !== 'file' || item.is_symlink) return

  const query = new URLSearchParams({ path: item.path })
  window.location.href =
    `/manager-api/servers/${serverId}/files/download?${query.toString()}`
}

function formatRemoteDate(timestamp: number | null) {
  if (!timestamp || !Number.isFinite(timestamp)) return '-'

  return new Date(timestamp * 1000).toLocaleString('id-ID', {
    dateStyle: 'medium',
    timeStyle: 'short',
    timeZone: 'Asia/Jakarta'
  })
}

function storageDeviceDescription(device: any) {
  return [
    device.fstype || '',
    device.label || '',
    device.mountpoint || ''
  ].filter(Boolean).join(' · ') || '-'
}
// FILE_MANAGER_SCRIPT_END

let historyInterval: ReturnType<typeof setInterval> | null = null

let monitoringInterval: ReturnType<typeof setInterval> | null = null

onMounted(async () => {
  await loadServer()

  // Muat informasi storage; Explorer dibuka melalui tombol Explore.
  if (server.value && fileManagerSupported.value) {
    void loadStorageDevices()
  }

  if (server.value && monitoringSupported.value) {
    // Ambil data pertama kali ketika halaman dibuka.
    await loadMonitoring()
    await loadHistory()

    // Live metrics diperbarui setiap 10 detik.
    monitoringInterval = setInterval(() => {
      void loadMonitoring()
    }, 10_000)

    // Histori diperbarui setiap 60 detik.
    historyInterval = setInterval(() => {
      void loadHistory()
    }, 60_000)
  }
})

onUnmounted(() => {
  // Hentikan timer ketika pengguna meninggalkan halaman.
  if (monitoringInterval !== null) {
    clearInterval(monitoringInterval)
    monitoringInterval = null
  }

  if (historyInterval !== null) {
    clearInterval(historyInterval)
    historyInterval = null
  }
})

const liveIntervalSec = ref<number>(10)
let liveTimer: ReturnType<typeof setInterval> | null = null

function stopLiveTimer() {
  if (liveTimer) {
    clearInterval(liveTimer)
    liveTimer = null
  }
}

function startLiveTimer() {
  stopLiveTimer()
  if (liveIntervalSec.value > 0 && monitoringSupported.value) {
    liveTimer = setInterval(() => {
      if (!monitoringLoading.value) loadMonitoring()
    }, liveIntervalSec.value * 1000)
  }
}

function metricTone(value: number | string | undefined) {
  const num = Number(value ?? 0)
  if (num >= 85) return 'critical'
  if (num >= 65) return 'warning'
  return 'healthy'
}

function metricLabel(value: number | string | undefined) {
  const num = Number(value ?? 0)
  if (num >= 85) return 'High'
  if (num >= 65) return 'Elevated'
  return 'Normal'
}

watch([liveIntervalSec, monitoringSupported], () => {
  startLiveTimer()
})

onMounted(() => {
  startLiveTimer()
})

onBeforeUnmount(() => {
  stopLiveTimer()
})

const fmSearchQuery = ref('')
const fmViewMode = ref<'list' | 'grid'>('list')
const fmSortKey = ref<'name' | 'size' | 'modified_at'>('name')
const fmSortAsc = ref(true)

function toggleFmSort(key: 'name' | 'size' | 'modified_at') {
  if (fmSortKey.value === key) {
    fmSortAsc.value = !fmSortAsc.value
  } else {
    fmSortKey.value = key
    fmSortAsc.value = true
  }
}

function fmFileIcon(item: any) {
  if (item?.is_symlink) return '🔗'
  if (item?.type === 'directory') return '📁'
  if (item?.type !== 'file') return '⚠️'
  const name = String(item?.name || '').toLowerCase()
  if (/\.(zip|tar|gz|tgz|rar|7z)$/.test(name)) return '🗜️'
  if (/\.(png|jpg|jpeg|gif|webp|svg|ico)$/.test(name)) return '🖼️'
  if (/\.(php|js|ts|vue|py|sh|html|css|json|sql)$/.test(name)) return '📜'
  if (/\.(env|conf|ini|yml|yaml|log|txt|md)$/.test(name)) return '⚙️'
  return '📄'
}

const filteredFileManagerItems = computed(() => {
  const q = fmSearchQuery.value.trim().toLowerCase()
  const list = Array.isArray(fileManagerItems.value) ? [...fileManagerItems.value] : []
  const filtered = q
    ? list.filter((it: any) => String(it?.name || '').toLowerCase().includes(q))
    : list

  return filtered.sort((a: any, b: any) => {
    const aDir = a?.type === 'directory' ? 0 : 1
    const bDir = b?.type === 'directory' ? 0 : 1
    if (aDir !== bDir) return aDir - bDir
    let cmp = 0
    if (fmSortKey.value === 'size') {
      cmp = Number(a?.size ?? -1) - Number(b?.size ?? -1)
    } else if (fmSortKey.value === 'modified_at') {
      cmp = String(a?.modified_at || '').localeCompare(String(b?.modified_at || ''))
    } else {
      cmp = String(a?.name || '').localeCompare(String(b?.name || ''), undefined, { sensitivity: 'base' })
    }
    return fmSortAsc.value ? cmp : -cmp
  })
})

const fmDirCount = computed(() => filteredFileManagerItems.value.filter((i: any) => i?.type === 'directory').length)
const fmFileCount = computed(() => filteredFileManagerItems.value.filter((i: any) => i?.type !== 'directory').length)

const imagePreviewOpen = ref(false)
const imagePreviewItem = ref<any>(null)
const imagePreviewUrl = ref('')
const imagePreviewLoading = ref(false)
const imagePreviewError = ref('')
const imagePreviewZoom = ref(1)

function isImageFile(item: any) {
  if (!item || item.type !== 'file' || item.is_symlink) return false
  return /\.(png|jpe?g|gif|webp|svg|bmp|ico|avif)$/i.test(String(item.name || ''))
}

const previewableImages = computed(() =>
  filteredFileManagerItems.value.filter((item: any) => isImageFile(item))
)

const currentPreviewIndex = computed(() => {
  if (!imagePreviewItem.value) return -1
  return previewableImages.value.findIndex((i: any) => i.path === imagePreviewItem.value.path)
})

function revokePreviewUrl() {
  if (imagePreviewUrl.value) {
    URL.revokeObjectURL(imagePreviewUrl.value)
    imagePreviewUrl.value = ''
  }
}

async function openImagePreview(item: any) {
  if (!isImageFile(item) || !fileManagerCanModifyCurrentPath.value) return
  imagePreviewItem.value = item
  imagePreviewOpen.value = true
  imagePreviewLoading.value = true
  imagePreviewError.value = ''
  imagePreviewZoom.value = 1
  revokePreviewUrl()

  try {
    const query = new URLSearchParams({ path: item.path })
    const res = await fetch(`/manager-api/servers/${serverId}/files/download?${query.toString()}`, {
      credentials: 'include'
    })
    if (!res.ok) throw new Error(`Gagal memuat gambar (HTTP ${res.status})`)
    const blob = await res.blob()
    imagePreviewUrl.value = URL.createObjectURL(blob)
  } catch (err: any) {
    imagePreviewError.value = err?.message || 'Gagal memuat preview gambar.'
  } finally {
    imagePreviewLoading.value = false
  }
}

function closeImagePreview() {
  imagePreviewOpen.value = false
  imagePreviewItem.value = null
  imagePreviewError.value = ''
  revokePreviewUrl()
}

function stepImagePreview(delta: number) {
  const list = previewableImages.value
  if (list.length <= 1 || currentPreviewIndex.value === -1) return
  const nextIdx = (currentPreviewIndex.value + delta + list.length) % list.length
  openImagePreview(list[nextIdx])
}

function handlePreviewKeydown(e: KeyboardEvent) {
  if (!imagePreviewOpen.value) return
  if (e.key === 'Escape') closeImagePreview()
  else if (e.key === 'ArrowLeft') stepImagePreview(-1)
  else if (e.key === 'ArrowRight') stepImagePreview(1)
}

onMounted(() => {
  window.addEventListener('keydown', handlePreviewKeydown)
})

onBeforeUnmount(() => {
  window.removeEventListener('keydown', handlePreviewKeydown)
  revokePreviewUrl()
})

const activeHistoryIndex = ref<number | null>(null)

const inspectedHistoryIndex = computed(() => {
  const len = historyPoints.value.length
  if (len === 0) return -1
  if (activeHistoryIndex.value !== null && activeHistoryIndex.value >= 0 && activeHistoryIndex.value < len) {
    return activeHistoryIndex.value
  }
  return len - 1
})

const inspectedPoint = computed(() => {
  const idx = inspectedHistoryIndex.value
  return idx >= 0 ? historyPoints.value[idx] : null
})

function chartThemeColor(key: string) {
  if (key.includes('cpu')) return '#3b82f6'
  if (key.includes('memory')) return '#10b981'
  if (key.includes('swap')) return '#f59e0b'
  if (key.includes('disk')) return '#a855f7'
  if (key.includes('rx')) return '#06b6d4'
  if (key.includes('tx')) return '#f97316'
  return '#3b82f6'
}

function historyAreaPath(metric: string) {
  const pts = historyPoints.value
  if (pts.length === 0) return ''
  const coords = pts.map((p: any, i: number) => `${historyX(i)},${historyY(Number(p[metric] || 0))}`)
  const firstX = historyX(0)
  const lastX = historyX(pts.length - 1)
  return `M ${firstX},160 L ${coords.join(' L ')} L ${lastX},160 Z`
}

function historyNetworkAreaPath(metric: string) {
  const pts = historyPoints.value
  if (pts.length === 0) return ''
  const coords = pts.map((_: any, i: number) => `${historyX(i)},${historyNetworkY(historyNetworkRate(i, metric))}`)
  const firstX = historyX(0)
  const lastX = historyX(pts.length - 1)
  return `M ${firstX},160 L ${coords.join(' L ')} L ${lastX},160 Z`
}

function historyStats(metric: string) {
  const vals = historyPoints.value.map((p: any) => Number(p[metric] || 0))
  if (vals.length === 0) return { min: 0, avg: 0, max: 0 }
  const sum = vals.reduce((a: number, b: number) => a + b, 0)
  return {
    min: Math.min(...vals),
    avg: sum / vals.length,
    max: Math.max(...vals),
  }
}

function historyNetworkStats(metric: string) {
  const vals = historyPoints.value.map((_: any, i: number) => historyNetworkRate(i, metric))
  if (vals.length === 0) return { min: 0, avg: 0, max: 0 }
  const sum = vals.reduce((a: number, b: number) => a + b, 0)
  return {
    min: Math.min(...vals),
    avg: sum / vals.length,
    max: Math.max(...vals),
  }
}

function handleChartPointer(event: MouseEvent | TouchEvent) {
  const pts = historyPoints.value
  if (pts.length === 0) return
  const target = event.currentTarget as SVGSVGElement | null
  if (!target) return
  const rect = target.getBoundingClientRect()
  if (rect.width <= 0) return

  const clientX = 'touches' in event && event.touches.length > 0
    ? event.touches[0].clientX
    : (event as MouseEvent).clientX

  const svgX = ((clientX - rect.left) / rect.width) * 600
  const clamped = Math.max(24, Math.min(576, svgX))
  if (pts.length === 1) {
    activeHistoryIndex.value = 0
    return
  }
  const ratio = (clamped - 24) / 552
  activeHistoryIndex.value = Math.max(0, Math.min(pts.length - 1, Math.round(ratio * (pts.length - 1))))
}

function clearChartPointer() {
  activeHistoryIndex.value = null
}

function historyPointDetail(point: any, key: string) {
  if (!point) return ''
  if (key === 'memory_usage_percent' && point.memory_total_mb) {
    return `${point.memory_used_mb ?? 0} / ${point.memory_total_mb} MB`
  }
  if (key === 'disk_usage_percent' && point.disk_total_gb) {
    return `${point.disk_used_gb ?? 0} / ${point.disk_total_gb} GB`
  }
  if (key === 'cpu_usage_percent' && point.load_average) {
    return `Load: ${Array.isArray(point.load_average) ? point.load_average.join(' / ') : point.load_average}`
  }
  return ''
}

function driveCapacityInfo(device: any) {
  if (!device) return null

  const findUsageNode = (node: any): any => {
    if (!node) return null
    if (node.usage_percent !== null && node.usage_percent !== undefined) return node
    const children = Array.isArray(node.children) ? node.children : []
    for (const child of children) {
      const found = findUsageNode(child)
      if (found) return found
    }
    return null
  }

  const target = findUsageNode(device)
  if (target) {
    const pct = Math.min(100, Math.max(0, Number(target.usage_percent) || 0))
    const mp = target.mountpoint ? ` (${target.mountpoint})` : ''
    return {
      hasUsage: true,
      percent: pct,
      summary: `${target.usage_summary || '-'}${mp}`,
      tone: pct >= 85 ? 'critical' : pct >= 65 ? 'warning' : 'healthy',
    }
  }

  return {
    hasUsage: false,
    percent: 0,
    summary: device.size ? `Total ${device.size} · Belum ter-mount` : 'Belum ter-mount',
    tone: 'idle',
  }
}
