<section v-if="!editing" class="connection-panel">
          <div class="connection-heading">
            <div>
              <h2>SSH Connection & Host Verification</h2>
              <p>
                Discover fingerprint dan uji autentikasi SSH server.
              </p>
            </div>

            <span
              v-if="server.connection_protocol === 'winrm'"
              class="protocol-note"
            >
              WinRM belum didukung
            </span>
          </div>

          <div class="connection-actions">
            <button
              v-if="['ssh', 'windows_openssh'].includes(server.connection_protocol)"
              type="button"
              class="secondary-action"
              :disabled="discoveringHostKey || testingConnection"
              @click="discoverHostKey"
            >
              {{ discoveringHostKey ? 'Discovering...' : 'Discover Host Key' }}
            </button>

            <button
              v-if="['ssh', 'windows_openssh'].includes(server.connection_protocol)"
              type="button"
              class="primary-action"
              :disabled="testingConnection || discoveringHostKey"
              @click="testConnection"
            >
              {{ testingConnection ? 'Testing...' : 'Test SSH Connection' }}
            </button>

            <button
              type="button"
              class="secondary-action"
              @click="editing = true; connectionError = ''; connectionMessage = ''"
            >
              Edit Configuration
            </button>
          </div>

          <div v-if="hostKeyCandidate" class="fingerprint-candidate">
            <h3>Discovered Host Key</h3>

            <div class="candidate-detail">
              <span>Key Algorithm</span>
              <strong>{{ hostKeyCandidate.key_type }}</strong>
            </div>

            <div class="candidate-detail">
              <span>SHA256 Fingerprint</span>
              <code>{{ hostKeyCandidate.fingerprint }}</code>
            </div>

            <p class="security-warning">
              Jangan percaya fingerprint hanya karena berhasil diambil dari
              jaringan. Bandingkan dengan fingerprint yang diperoleh langsung
              dari server melalui console atau jalur tepercaya.
            </p>

            <label class="trust-confirmation">
              <input v-model="fingerprintTrusted" type="checkbox" />
              <span>
                Saya sudah membandingkan fingerprint ini melalui jalur
                tepercaya dan memastikan nilainya cocok.
              </span>
            </label>

            <button
              type="button"
              class="primary-action"
              :disabled="!fingerprintTrusted"
              @click="useDiscoveredFingerprint"
            >
              Use Verified Fingerprint
            </button>
          </div>

          <p v-if="connectionMessage" class="connection-success" role="status">
            {{ connectionMessage }}
          </p>

          <p v-if="connectionError" class="connection-error" role="alert">
            {{ connectionError }}
          </p>

          <p
            v-if="!server.verify_host_key"
            class="security-warning"
          >
            Peringatan: verifikasi host key dinonaktifkan. Identitas server
            tidak diperiksa sebelum autentikasi.
          </p>

          <p
            v-else-if="!server.host_key_fingerprint"
            class="security-warning"
          >
            Host key belum terdaftar. Test Connection akan ditolak sampai
            fingerprint diverifikasi dan disimpan.
          </p>
        </section>

