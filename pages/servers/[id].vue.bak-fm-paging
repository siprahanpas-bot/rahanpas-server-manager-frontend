                            <span class="aa-file-ico">{{ fmFileIcon(item) }}</span>
                            <span class="aa-entry-name">{{ item.name }}</span>
                          </button>
                          <span v-else class="aa-entry-static">
                            <span class="aa-file-ico">{{ fmFileIcon(item) }}</span>
                            <span class="aa-entry-name">{{ item.name }}</span>
                          </span>
                        </td>
                        <td>
                          <span class="aa-type-pill">{{ item.is_symlink ? 'Symlink' : item.type === 'directory' ? 'Folder' : item.type }}</span>
                        </td>
                        <td><code class="aa-pmsn">{{ item.permissions || '-' }}</code></td>
                        <td class="aa-num">{{ item.size === null ? '-' : formatBytes(item.size) }}</td>
                        <td class="aa-num">{{ formatRemoteDate(item.modified_at) }}</td>
                        <td class="aa-op-col">
                          <div class="aa-op-links">
                            <button
                              v-if="item.type === 'directory' && !item.is_symlink"
