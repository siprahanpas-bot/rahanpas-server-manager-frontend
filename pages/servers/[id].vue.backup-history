<script setup lang="ts">
interface ManagedServer {
  id: number
  name: string
  hostname: string | null
  ip_address: string | null
  os_type: 'linux' | 'windows'
  connection_protocol: string
  port: number
  username: string
  auth_method: 'password' | 'private_key'
  verify_host_key: boolean
  host_key_fingerprint: string | null
  status: string
  last_checked_at: string | null
  last_error: string | null
  notes: string | null
  created_at: string
  updated_at: string
}

const route = useRoute()
const serverId = String(route.params.id)

const server = ref<ManagedServer | null>(null)
const loading = ref(true)
const saving = ref(false)
const deleting = ref(false)
const editing = ref(false)
const errorMessage = ref('')
const fieldErrors = ref<Record<string, string[]>>({})

const discoveringHostKey = ref(false)
const testingConnection = ref(false)
const connectionMessage = ref('')
const connectionError = ref('')
const hostKeyCandidate = ref<{
  key_type: string
  fingerprint: string
} | null>(null)
const fingerprintTrusted = ref(false)


const form = reactive({
  name: '',
  hostname: '',
  ip_address: '',
  os_type: 'linux',
  connection_protocol: 'ssh',
  port: 22,
  username: '',
  auth_method: 'password',
  password: '',
  private_key: '',
  private_key_passphrase: '',
  verify_host_key: true,
  host_key_fingerprint: '',
  notes: ''
})

const protocolLabel = computed(() => {
  const labels: Record<string, string> = {
    ssh: 'SSH',
    winrm: 'WinRM',
    windows_openssh: 'Windows OpenSSH'
  }
  return labels[server.value?.connection_protocol || ''] || '-'
})

const authLabel = computed(() =>
  server.value?.auth_method === 'private_key'
    ? 'SSH Private Key'
    : 'Username & Password'
)

function statusClass(status: string) {
  return {
    online: 'status-online',
    offline: 'status-offline',
    error: 'status-error',
    unknown: 'status-unknown'
  }[status] || 'status-unknown'
}

function formatDate(value: string | null) {
  if (!value) return 'Belum diperiksa'

  return new Date(value).toLocaleString('id-ID', {
    dateStyle: 'medium',
    timeStyle: 'short'
  })
}

function populateForm(data: ManagedServer) {
  form.name = data.name
  form.hostname = data.hostname || ''
  form.ip_address = data.ip_address || ''
  form.os_type = data.os_type
  form.connection_protocol = data.connection_protocol
  form.port = data.port
  form.username = data.username
  form.auth_method = data.auth_method
  form.password = ''
  form.private_key = ''
  form.private_key_passphrase = ''
  form.verify_host_key = data.verify_host_key
  form.host_key_fingerprint = data.host_key_fingerprint || ''
  form.notes = data.notes || ''
}

async function loadServer() {
  loading.value = true
  errorMessage.value = ''

  try {
    const result: any = await $fetch(`/manager-api/servers/${serverId}`)
    server.value = result.server
    populateForm(result.server)
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    errorMessage.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal mengambil informasi server.'
  } finally {
    loading.value = false
  }
}

function cancelEdit() {
  if (server.value) populateForm(server.value)
  editing.value = false
  errorMessage.value = ''
  fieldErrors.value = {}
}

watch(() => form.os_type, (os) => {
  if (os === 'linux') {
    form.connection_protocol = 'ssh'
    form.port = 22
  } else {
    form.connection_protocol = 'winrm'
    form.port = 5985
  }
})

watch(() => form.connection_protocol, (protocol) => {
  form.port = protocol === 'winrm' ? 5985 : 22

  if (protocol === 'winrm' && form.auth_method === 'private_key') {
    form.auth_method = 'password'
  }
})

watch(() => form.auth_method, () => {
  form.password = ''
  form.private_key = ''
  form.private_key_passphrase = ''
})

async function saveChanges() {
  saving.value = true
  errorMessage.value = ''
  fieldErrors.value = {}

  const payload: Record<string, any> = {
    name: form.name,
    hostname: form.hostname || null,
    ip_address: form.ip_address || null,
    os_type: form.os_type,
    connection_protocol: form.connection_protocol,
    port: form.port,
    username: form.username,
    auth_method: form.auth_method,
    verify_host_key: form.verify_host_key,
    host_key_fingerprint: form.host_key_fingerprint || null,
    notes: form.notes || null
  }

  // Jangan kirim credential lama atau field credential kosong.
  // Credential hanya dikirim jika pengguna memasukkan yang baru.
  if (form.auth_method === 'password' && form.password) {
    payload.password = form.password
  }

  if (form.auth_method === 'private_key') {
    if (form.private_key) {
      payload.private_key = form.private_key
      payload.private_key_passphrase =
        form.private_key_passphrase || null
    }
  }

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}`,
      {
        method: 'PUT',
        body: payload
      }
    )

    server.value = result.server
    populateForm(result.server)
    editing.value = false
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    errorMessage.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal memperbarui konfigurasi server.'

    fieldErrors.value =
      error.data?.data?.errors ||
      error.data?.errors ||
      {}
  } finally {
    saving.value = false
  }
}


async function discoverHostKey() {
  if (!server.value) return

  discoveringHostKey.value = true
  connectionError.value = ''
  connectionMessage.value = ''
  hostKeyCandidate.value = null
  fingerprintTrusted.value = false

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/discover-host-key`,
      { method: 'POST' }
    )

    hostKeyCandidate.value = result.host_key
    connectionMessage.value =
      result.warning ||
      'Bandingkan fingerprint dengan server melalui jalur tepercaya.'
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    connectionError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal mengambil SSH host key.'
  } finally {
    discoveringHostKey.value = false
  }
}

function useDiscoveredFingerprint() {
  if (!hostKeyCandidate.value || !fingerprintTrusted.value) return

  form.host_key_fingerprint = hostKeyCandidate.value.fingerprint
  form.verify_host_key = true

  hostKeyCandidate.value = null
  fingerprintTrusted.value = false
  connectionMessage.value =
    'Fingerprint dimasukkan ke form. Klik Save Changes untuk menyimpannya.'
  editing.value = true
}

async function testConnection() {
  if (!server.value || testingConnection.value) return

  if (
    !['ssh', 'windows_openssh'].includes(
      server.value.connection_protocol
    )
  ) {
    connectionError.value =
      'Pengujian koneksi untuk protokol ini belum tersedia.'
    return
  }

  if (
    server.value.verify_host_key &&
    !server.value.host_key_fingerprint
  ) {
    connectionError.value =
      'Fingerprint host key belum tersimpan. Lakukan discovery, verifikasi, dan simpan fingerprint terlebih dahulu.'
    return
  }

  testingConnection.value = true
  connectionError.value = ''
  connectionMessage.value = ''

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/test-connection`,
      { method: 'POST' }
    )

    if (result.server) {
      server.value = result.server
      populateForm(result.server)
    }

    connectionMessage.value =
      result.message || 'Koneksi SSH berhasil.'
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    connectionError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Pengujian koneksi gagal.'

    // Ambil status terbaru yang mungkin sudah diperbarui backend.
    await loadServer()
  } finally {
    testingConnection.value = false
  }
}

async function deleteServer() {
  if (!server.value) return

  const confirmed = confirm(
    `Apakah Anda yakin ingin menghapus server "${server.value.name}"?\n\nTindakan ini tidak dapat dibatalkan.`
  )

  if (!confirmed) return

  deleting.value = true
  errorMessage.value = ''

  try {
    await $fetch(`/manager-api/servers/${serverId}`, {
      method: 'DELETE'
    })

    await navigateTo('/servers')
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    errorMessage.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal menghapus server.'
  } finally {
    deleting.value = false
  }
}


const metrics = ref<any>(null)
const monitoringLoading = ref(false)
const monitoringError = ref('')
const monitoringMessage = ref('')

const monitoringSupported = computed(() =>
  server.value?.os_type === 'linux' &&
  server.value?.connection_protocol === 'ssh'
)

async function loadMonitoring() {
  if (!server.value || !monitoringSupported.value || monitoringLoading.value) {
    return
  }

  monitoringLoading.value = true
  monitoringError.value = ''
  monitoringMessage.value = ''

  try {
    const result: any = await $fetch(
      `/manager-api/servers/${serverId}/monitoring`
    )

    metrics.value = result.metrics

    server.value.status = result.server_status?.status || 'online'
    server.value.last_checked_at =
      result.server_status?.last_checked_at || new Date().toISOString()
    server.value.last_error = null

    monitoringMessage.value = result.message || 'Monitoring berhasil diperbarui.'
  } catch (error: any) {
    if (error.statusCode === 401) {
      await navigateTo('/')
      return
    }

    monitoringError.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Gagal mengambil data monitoring.'

    if (server.value) {
      server.value.status = 'error'
      server.value.last_error = monitoringError.value
      server.value.last_checked_at = new Date().toISOString()
    }
  } finally {
    monitoringLoading.value = false
  }
}

function formatBytes(value: number) {
  if (!Number.isFinite(value) || value < 0) return '-'

  const units = ['B', 'KB', 'MB', 'GB', 'TB']
  let size = value
  let index = 0

  while (size >= 1024 && index < units.length - 1) {
    size /= 1024
    index++
  }

  return `${size.toFixed(2)} ${units[index]}`
}

function formatUptime(value: number) {
  if (!Number.isFinite(value) || value < 0) return '-'

  const days = Math.floor(value / 86400)
  const hours = Math.floor((value % 86400) / 3600)
  const minutes = Math.floor((value % 3600) / 60)

  return `${days} hari ${hours} jam ${minutes} menit`
}

let monitoringInterval: ReturnType<typeof setInterval> | null = null

onMounted(async () => {
  await loadServer()

  if (server.value && monitoringSupported.value) {
    // Ambil data pertama kali ketika halaman dibuka.
    await loadMonitoring()

    // Perbarui metrik secara otomatis setiap 10 detik.
    monitoringInterval = setInterval(() => {
      void loadMonitoring()
    }, 10_000)
  }
})

onUnmounted(() => {
  // Hentikan timer ketika pengguna meninggalkan halaman.
  if (monitoringInterval !== null) {
    clearInterval(monitoringInterval)
    monitoringInterval = null
  }
})
</script>

<template>
  <main class="page">
    <header class="topbar">
      <div>
        <div class="breadcrumb">
          Workspace / Infrastructure / Servers / Detail
        </div>
        <h1>{{ server?.name || 'Server Detail' }}</h1>
        <p>Informasi dan konfigurasi server yang terdaftar.</p>
      </div>

      <NuxtLink to="/servers" class="back-button">
        ← Back to Servers
      </NuxtLink>
    </header>

    <div class="content">
      <div v-if="loading" class="loading">
        Memuat informasi server...
      </div>

      <div v-else-if="!server" class="alert">
        {{ errorMessage || 'Server tidak ditemukan.' }}
      </div>

      <template v-else>
        <div class="summary-grid">
          <article class="summary-card">
            <span>SERVER STATUS</span>
            <strong>
              <span class="status" :class="statusClass(server.status)">
                {{ server.status }}
              </span>
            </strong>
            <small>
              {{ server.status === 'unknown'
                ? 'Monitoring belum dijalankan'
                : server.last_error || 'Status koneksi terakhir' }}
            </small>
          </article>

          <article class="summary-card">
            <span>OPERATING SYSTEM</span>
            <strong>
              {{ server.os_type === 'linux' ? '🐧 Linux' : '▣ Windows' }}
            </strong>
            <small>{{ protocolLabel }}</small>
          </article>

          <article class="summary-card">
            <span>IP ADDRESS</span>
            <strong>{{ server.ip_address || '-' }}</strong>
            <small>{{ server.hostname || 'Hostname tidak tersedia' }}</small>
          </article>

          <article class="summary-card">
            <span>LAST CHECK</span>
            <strong class="date-value">
              {{ formatDate(server.last_checked_at) }}
            </strong>
            <small>
              {{ server.last_checked_at
                ? 'Pemeriksaan koneksi terakhir'
                : 'Belum ada pemeriksaan koneksi' }}
            </small>
          </article>
        </div>


        <section class="monitoring-panel">
          <div class="monitoring-heading">
            <div>
              <h2>Live Server Monitoring</h2>
              <p>
                Penggunaan resource dan kondisi sistem dari server secara langsung.
              </p>
            </div>

            <button
              v-if="monitoringSupported"
              type="button"
              class="monitoring-refresh"
              :disabled="monitoringLoading"
              @click="loadMonitoring"
            >
              {{ monitoringLoading ? 'Mengambil data...' : '↻ Refresh Metrics' }}
            </button>
          </div>

          <div v-if="!monitoringSupported" class="monitoring-placeholder">
            Monitoring saat ini hanya tersedia untuk server Linux dengan protokol SSH.
          </div>

          <template v-else>
            <div v-if="monitoringLoading && !metrics" class="monitoring-placeholder">
              Menghubungkan ke server dan mengambil metrik...
            </div>

            <div v-if="monitoringError" class="monitoring-error" role="alert">
              {{ monitoringError }}
            </div>

            <template v-if="metrics">
              <div class="monitoring-system-info">
                <div>
                  <span>HOSTNAME</span>
                  <strong>{{ metrics.hostname }}</strong>
                </div>
                <div>
                  <span>OPERATING SYSTEM</span>
                  <strong>{{ metrics.os_name }}</strong>
                </div>
                <div>
                  <span>KERNEL</span>
                  <strong>{{ metrics.kernel }}</strong>
                </div>
                <div>
                  <span>UPTIME</span>
                  <strong>{{ formatUptime(metrics.uptime_seconds) }}</strong>
                </div>
              </div>

              <div class="resource-grid">
                <article class="resource-card">
                  <div class="resource-title">
                    <span>CPU USAGE</span>
                    <strong>{{ metrics.cpu.usage_percent }}%</strong>
                  </div>
                  <div class="resource-track">
                    <div
                      class="resource-fill cpu-fill"
                      :style="{ width: metrics.cpu.usage_percent + '%' }"
                    ></div>
                  </div>
                  <small>Load: {{ metrics.load_average.join(' / ') }}</small>
                </article>

                <article class="resource-card">
                  <div class="resource-title">
                    <span>MEMORY USAGE</span>
                    <strong>{{ metrics.memory.usage_percent }}%</strong>
                  </div>
                  <div class="resource-track">
                    <div
                      class="resource-fill memory-fill"
                      :style="{ width: metrics.memory.usage_percent + '%' }"
                    ></div>
                  </div>
                  <small>
                    {{ metrics.memory.used_mb }} MB /
                    {{ metrics.memory.total_mb }} MB
                  </small>
                </article>

                <article class="resource-card">
                  <div class="resource-title">
                    <span>SWAP USAGE</span>
                    <strong>{{ metrics.swap.usage_percent }}%</strong>
                  </div>
                  <div class="resource-track">
                    <div
                      class="resource-fill swap-fill"
                      :style="{ width: metrics.swap.usage_percent + '%' }"
                    ></div>
                  </div>
                  <small>
                    {{ metrics.swap.used_mb }} MB /
                    {{ metrics.swap.total_mb }} MB
                  </small>
                </article>

                <article class="resource-card">
                  <div class="resource-title">
                    <span>ROOT DISK USAGE</span>
                    <strong>{{ metrics.disk.usage_percent }}%</strong>
                  </div>
                  <div class="resource-track">
                    <div
                      class="resource-fill disk-fill"
                      :style="{ width: metrics.disk.usage_percent + '%' }"
                    ></div>
                  </div>
                  <small>
                    {{ metrics.disk.used_gb }} GB /
                    {{ metrics.disk.total_gb }} GB
                  </small>
                </article>
              </div>

              <div class="network-grid">
                <article class="network-card">
                  <span>↓ NETWORK RECEIVED (RX)</span>
                  <strong>{{ formatBytes(metrics.network.rx_bytes) }}</strong>
                  <small>Total bytes received since interface counters started</small>
                </article>
                <article class="network-card">
                  <span>↑ NETWORK SENT (TX)</span>
                  <strong>{{ formatBytes(metrics.network.tx_bytes) }}</strong>
                  <small>Total bytes sent since interface counters started</small>
                </article>
              </div>

              <div class="monitoring-footer">
                <span>
                  Last collected:
                  {{ formatDate(metrics.collected_at) }}
                </span>
                <span>{{ monitoringMessage }}</span>
              </div>
            </template>

            <div
              v-else-if="!monitoringLoading && !monitoringError"
              class="monitoring-placeholder"
            >
              Belum ada data monitoring. Klik Refresh Metrics untuk mencoba lagi.
            </div>
          </template>
        </section>

        <section v-if="!editing" class="connection-panel">
          <div class="connection-heading">
            <div>
              <h2>SSH Connection & Host Verification</h2>
              <p>
                Discover fingerprint dan uji autentikasi SSH server.
              </p>
            </div>

            <span
              v-if="server.connection_protocol === 'winrm'"
              class="protocol-note"
            >
              WinRM belum didukung
            </span>
          </div>

          <div class="connection-actions">
            <button
              v-if="['ssh', 'windows_openssh'].includes(server.connection_protocol)"
              type="button"
              class="secondary-action"
              :disabled="discoveringHostKey || testingConnection"
              @click="discoverHostKey"
            >
              {{ discoveringHostKey ? 'Discovering...' : 'Discover Host Key' }}
            </button>

            <button
              v-if="['ssh', 'windows_openssh'].includes(server.connection_protocol)"
              type="button"
              class="primary-action"
              :disabled="testingConnection || discoveringHostKey"
              @click="testConnection"
            >
              {{ testingConnection ? 'Testing...' : 'Test SSH Connection' }}
            </button>

            <button
              type="button"
              class="secondary-action"
              @click="editing = true; connectionError = ''; connectionMessage = ''"
            >
              Edit Configuration
            </button>
          </div>

          <div v-if="hostKeyCandidate" class="fingerprint-candidate">
            <h3>Discovered Host Key</h3>

            <div class="candidate-detail">
              <span>Key Algorithm</span>
              <strong>{{ hostKeyCandidate.key_type }}</strong>
            </div>

            <div class="candidate-detail">
              <span>SHA256 Fingerprint</span>
              <code>{{ hostKeyCandidate.fingerprint }}</code>
            </div>

            <p class="security-warning">
              Jangan percaya fingerprint hanya karena berhasil diambil dari
              jaringan. Bandingkan dengan fingerprint yang diperoleh langsung
              dari server melalui console atau jalur tepercaya.
            </p>

            <label class="trust-confirmation">
              <input v-model="fingerprintTrusted" type="checkbox" />
              <span>
                Saya sudah membandingkan fingerprint ini melalui jalur
                tepercaya dan memastikan nilainya cocok.
              </span>
            </label>

            <button
              type="button"
              class="primary-action"
              :disabled="!fingerprintTrusted"
              @click="useDiscoveredFingerprint"
            >
              Use Verified Fingerprint
            </button>
          </div>

          <p v-if="connectionMessage" class="connection-success" role="status">
            {{ connectionMessage }}
          </p>

          <p v-if="connectionError" class="connection-error" role="alert">
            {{ connectionError }}
          </p>

          <p
            v-if="!server.verify_host_key"
            class="security-warning"
          >
            Peringatan: verifikasi host key dinonaktifkan. Identitas server
            tidak diperiksa sebelum autentikasi.
          </p>

          <p
            v-else-if="!server.host_key_fingerprint"
            class="security-warning"
          >
            Host key belum terdaftar. Test Connection akan ditolak sampai
            fingerprint diverifikasi dan disimpan.
          </p>
        </section>

        <section class="configuration">
          <div class="section-heading">
            <div>
              <h2>Server Configuration</h2>
              <p>Informasi konfigurasi server yang tersimpan.</p>
            </div>

            <button
              v-if="!editing"
              class="edit-button"
              @click="editing = true"
            >
              ✎ Edit Server
            </button>
          </div>

          <div v-if="!editing" class="details">
            <div class="detail-item">
              <span>Server Name</span>
              <strong>{{ server.name }}</strong>
            </div>

            <div class="detail-item">
              <span>IP Address</span>
              <strong>{{ server.ip_address || '-' }}</strong>
            </div>

            <div class="detail-item">
              <span>Hostname / FQDN</span>
              <strong>{{ server.hostname || '-' }}</strong>
            </div>

            <div class="detail-item">
              <span>Operating System</span>
              <strong>{{ server.os_type }}</strong>
            </div>

            <div class="detail-item">
              <span>Connection Protocol</span>
              <strong>{{ protocolLabel }}</strong>
            </div>

            <div class="detail-item">
              <span>Port</span>
              <strong>{{ server.port }}</strong>
            </div>

            <div class="detail-item">
              <span>Username</span>
              <strong>{{ server.username }}</strong>
            </div>

            <div class="detail-item">
              <span>Authentication</span>
              <strong>{{ authLabel }}</strong>
            </div>

            <div class="detail-item">
              <span>Host Key Verification</span>
              <strong>
                {{ server.connection_protocol === 'winrm'
                  ? 'Not applicable'
                  : server.verify_host_key ? 'Enabled' : 'Disabled' }}
              </strong>
            </div>

            <div class="detail-item">
              <span>Host Key Fingerprint</span>
              <strong>{{ server.host_key_fingerprint || '-' }}</strong>
            </div>

            <div class="detail-item">
              <span>Created At</span>
              <strong>{{ formatDate(server.created_at) }}</strong>
            </div>

            <div class="detail-item">
              <span>Last Updated</span>
              <strong>{{ formatDate(server.updated_at) }}</strong>
            </div>

            <div class="detail-item full">
              <span>NOTES</span>
              <strong class="notes">
                {{ server.notes || 'Tidak ada catatan.' }}
              </strong>
            </div>
          </div>

          <form v-else class="edit-form" @submit.prevent="saveChanges">
            <div class="form-section">
              <h3>01. Server Information</h3>

              <div class="fields">
                <label class="field full">
                  <span>Server Name *</span>
                  <input v-model.trim="form.name" required maxlength="100" />
                  <small v-if="fieldErrors.name" class="field-error">{{ fieldErrors.name[0] }}</small>
                </label>

                <label class="field">
                  <span>IP Address</span>
                  <input v-model.trim="form.ip_address" placeholder="192.168.1.10" />
                  <small v-if="fieldErrors.ip_address" class="field-error">{{ fieldErrors.ip_address[0] }}</small>
                </label>

                <label class="field">
