<script setup lang="ts">
const route = useRoute()
const loading = ref(true)
const errorMessage = ref('')
const email = String(route.query.email || '')
const token = String(route.query.token || '')

onMounted(async () => {
  if (!email || !token) {
    errorMessage.value = 'Tautan verifikasi tidak lengkap.'
    loading.value = false
    return
  }

  try {
    const result: any = await $fetch('/auth/verify-email', {
      method: 'POST',
      body: { email, token }
    })

    await navigateTo({
      path: '/set-password',
      query: {
        email,
        token: result.password_setup_token
      }
    })
  } catch (error: any) {
    errorMessage.value =
      error.data?.statusMessage ||
      error.data?.message ||
      'Tautan verifikasi tidak valid atau sudah kedaluwarsa.'
  } finally {
    loading.value = false
  }
})
</script>

<template>
  <main class="auth-layout">
    <section class="auth-card">
      <div class="brand">
        <span class="brand-logo">R</span>
        <span>RAHANPAS</span>
      </div>

      <div v-if="loading" class="state">
        <div class="spinner"></div>
        <h1>Memverifikasi email</h1>
        <p>Mohon tunggu, kami sedang memeriksa tautan verifikasi Anda.</p>
      </div>

      <div v-else class="state">
        <h1>Verifikasi belum berhasil</h1>
        <p class="error">{{ errorMessage }}</p>
        <NuxtLink to="/register">Kembali ke registrasi</NuxtLink>
      </div>
    </section>
  </main>
</template>

